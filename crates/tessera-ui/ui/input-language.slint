import { ScrollView as NativeScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { TileButton, FocusTokens } from "tiles.slint";
import { PopoverBody, PopoverTokens } from "popover.slint";
import { Slint1181FluentNativeGridMetrics } from "native-grid-metrics.slint";

export struct InputProfileRow {
    key: string,
    language-name: string,
    layout-name: string,
    active: bool,
}

component InputLanguageText inherits Text {
    font-family: PopoverTokens.font-family;
    font-size: PopoverTokens.font-size;
    color: SeelenPalette.foreground;
    accessible-role: none;
}

component InputProfileButton inherits TileButton {
    in property <InputProfileRow> profile-row;
    activation-key: root.profile-row.key;
    in property <length> language-height;
    in property <length> description-height;
    in property <float> text-line-height-factor;
    // Missing native metadata is explicitly unavailable, never a guessed locale.
    property <string> language-label: root.profile-row.language-name != ""
        ? root.profile-row.language-name : @tr("Language name unavailable");
    property <string> profile-label: root.profile-row.layout-name != ""
        ? root.profile-row.layout-name : @tr("Keyboard profile name unavailable");
    radius: 6px; // Published radius-s, as used by the existing native list tiles.
    filled: false;
    allow-return-repeat: false;
    selected: false; // Focus ring is not an observation of the active profile.
    opacity: 1;
    accessible-text: root.language-label + " - " + root.profile-label;
    accessible-description: root.profile-row.active ? @tr("Active keyboard profile") : "";
    accessible-item-selectable: true;
    accessible-item-selected: root.profile-row.active;
    background: root.pressed ? SeelenPalette.pressed
        : root.hovered && root.enabled ? SeelenPalette.hover : transparent;
    if root.profile-row.active: Rectangle {
        width: root.width;
        height: root.height;
        border-radius: root.radius;
        background: SeelenPalette.accent.with-alpha(0.10);
        accessible-role: none;
    }
    // Original CC BY FaRegKeyboard, with native containment in the source
    // 20px slot; generated browser viewport width is not certified.
    Image {
        x: 12px;
        y: (root.height - self.height) / 2;
        width: 20px;
        height: 16px;
        source: @image-url("../assets/icons/font-awesome-free-afecf2a/keyboard.svg");
        colorize: SeelenPalette.foreground;
        image-fit: contain;
        accessible-role: none;
    }
    InputLanguageText {
        x: 40px; // Published spacing-s + 20px icon slot + spacing-xs.
        y: 8px;
        width: max(0px, root.width - self.x - 12px);
        height: root.language-height;
        text: root.language-label;
        font-weight: 600;
        line-height-factor: root.text-line-height-factor;
        overflow: elide;
    }
    InputLanguageText {
        x: 40px;
        y: 8px + root.language-height;
        width: max(0px, root.width - self.x - 12px);
        height: root.description-height;
        text: root.profile-label;
        font-weight: 600;
        color: SeelenPalette.secondary;
        line-height-factor: root.text-line-height-factor;
        overflow: elide;
    }
}

// Presentation has no native identities, handles, indexes or desktop effects.
export component InputLanguageMenu inherits Window {
    default-font-family: SeelenPalette.font-family;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera keyboard selector";
    min-width: 1px;
    min-height: 1px;
    in property <[InputProfileRow]> rows;
    in property <string> settings-key;
    in property <bool> loading;
    in property <bool> action-pending;
    in property <bool> observed;
    in property <bool> unknown-active;
    in property <string> notice;
    in property <bool> retry-enabled;
    callback select-profile(string);
    callback open-settings(string);
    callback retry-requested();
    callback hide-requested();
    callback input-event-ready();
    callback preferred-size-changed();

    out property <length> popup-content-width: 300px + 2 * PopoverTokens.shadow-margin;
    out property <length> popup-content-height: min(700px,
        root.header-height + root.natural-list-height + root.footer-height)
        + 2 * PopoverTokens.shadow-margin;
    preferred-width: root.popup-content-width;
    preferred-height: root.popup-content-height;
    changed popup-content-width => { root.preferred-size-changed(); }
    changed popup-content-height => { root.preferred-size-changed(); }

    property <length> description-height: max(1px, PopoverTokens.font-size * PopoverTokens.line-height);
    property <length> language-height: root.description-height;
    property <length> row-height: 16px + root.language-height + root.description-height;
    property <length> row-gap: 8px;
    property <length> row-stride: root.row-height + root.row-gap;
    property <length> rows-extent: root.rows.length > 0
        ? root.rows.length * root.row-stride - root.row-gap : 0px;
    // Absorb the native focus gutter into source spacing, rather than adding
    // it to every source gap. Larger custom focus reserves remain unclipped.
    property <length> inset-remainder: max(0px, 8px - FocusTokens.outer-margin);
    property <length> footer-button-height: root.description-height + PopoverTokens.font-size * 0.5;
    property <length> header-height: 8px + root.description-height + root.inset-remainder;
    property <length> footer-height: root.inset-remainder + root.footer-button-height
        + max(8px, FocusTokens.outer-margin);
    property <length> feedback-top: root.rows-extent + (root.rows.length > 0 ? root.row-gap : 0px);
    property <length> retry-height: 16px + root.description-height;
    pure function retry-top(feedback-height: length) -> length {
        return root.feedback != "" ? root.feedback-top + feedback-height + root.row-gap
            : root.rows-extent + (root.rows.length > 0 ? root.row-gap : 0px);
    }
    pure function list-extent(feedback-height: length) -> length {
        return 2 * FocusTokens.outer-margin + (root.retry-enabled
            ? root.retry-top(feedback-height) + root.retry-height
            : root.feedback != "" ? root.feedback-top + feedback-height : root.rows-extent);
    }
    property <string> feedback: root.action-pending ? @tr("Applying keyboard request…")
        : root.notice != "" ? root.notice
        : root.loading ? @tr("Loading keyboard profiles…")
        : root.observed && root.rows.length == 0 ? @tr("No keyboard profiles are enabled.")
        : root.observed && root.unknown-active ? @tr("Active keyboard profile unavailable.") : "";
    property <length> natural-list-height: root.list-extent(feedback-metrics.preferred-height);
    property <length> unreserved-list-height: root.list-extent(unreserved-feedback-metrics.preferred-height);
    property <length> viewport-width: max(0px, body.content-width - 2 * root.inset-remainder);
    property <length> measure-width: max(1px,
        root.viewport-width - 2 * FocusTokens.outer-margin - 24px);
    property <length> actual-footer-height: min(root.footer-height, body.content-height);
    property <length> actual-header-height: min(root.header-height,
        max(0px, body.content-height - root.actual-footer-height));
    property <length> list-width: Slint1181FluentNativeGridMetrics.source-width(
        root.viewport-width, root.unreserved-list-height, scroll.visible-height, ScrollBarPolicy.as-needed);

    unreserved-feedback-metrics := InputLanguageText {
        width: root.measure-width;
        height: 0px;
        opacity: 0;
        text: root.feedback;
        wrap: word-wrap;
        line-height-factor: body.text-line-height-factor;
    }
    feedback-metrics := InputLanguageText {
        width: max(1px, root.measure-width - (root.viewport-width - root.list-width));
        height: 0px;
        opacity: 0;
        text: root.feedback;
        wrap: word-wrap;
        line-height-factor: body.text-line-height-factor;
    }
    function reveal-focused(top: length, item-height: length) {
        let visible-top = -scroll.content-y;
        let desired-top = max(0px, top - FocusTokens.outer-margin);
        let desired-bottom = top + item-height + FocusTokens.outer-margin;
        if desired-top < visible-top {
            scroll.content-y = -desired-top;
        } else if desired-bottom > visible-top + scroll.visible-height {
            scroll.content-y = -max(0px, min(desired-bottom - scroll.visible-height,
                scroll.content-height - scroll.visible-height));
        }
    }
    public function set-presentation-opacity(value: float) { body.set-presentation-opacity(value); }
    // Hide cancels input immediately; projection keys guard rebinds without
    // disrupting ordinary keyboard navigation within the open selector.
    public function cancel-input() {
        footer.cancel-input();
        escape-scope.focus();
    }
    public function focus-content() {
        scroll.content-y = 0px;
        escape-scope.focus();
    }
    forward-focus: escape-scope;
    escape-scope := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape { root.hide-requested(); return accept; }
            return reject;
        }
        body := PopoverBody {
            x: max(0px, (root.width - self.width) / 2);
            width: min(root.width, root.popup-content-width);
            height: root.height;
            InputLanguageText {
                x: 8px;
                y: 8px;
                width: max(0px, body.content-width - 16px);
                height: max(0px, min(root.description-height, root.actual-header-height - 8px));
                text: @tr("Keyboard layout");
                font-weight: 600;
                line-height-factor: body.text-line-height-factor;
                overflow: elide;
                accessible-role: text;
            }
            scroll := NativeScrollView {
                x: root.inset-remainder;
                y: root.actual-header-height;
                width: root.viewport-width;
                height: max(0px, body.content-height - root.actual-header-height - root.actual-footer-height);
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                content-width: root.list-width;
                content-height: root.natural-list-height;
                for row[index] in root.rows: InputProfileButton {
                    x: FocusTokens.outer-margin;
                    y: FocusTokens.outer-margin + index * root.row-stride;
                    width: max(0px, scroll.content-width - 2 * FocusTokens.outer-margin);
                    height: root.row-height;
                    profile-row: row;
                    language-height: root.language-height;
                    description-height: root.description-height;
                    text-line-height-factor: body.text-line-height-factor;
                    enabled: !root.loading && !root.action-pending && row.key != "";
                    clicked => { root.select-profile(row.key); }
                    focus-acquired => { root.reveal-focused(self.y, self.height); }
                }
                if root.feedback != "": InputLanguageText {
                    x: FocusTokens.outer-margin + 12px;
                    y: FocusTokens.outer-margin + root.feedback-top;
                    width: max(0px, scroll.content-width - 2 * self.x);
                    height: feedback-metrics.preferred-height;
                    text: root.feedback;
                    color: SeelenPalette.secondary;
                    wrap: word-wrap;
                    line-height-factor: body.text-line-height-factor;
                    accessible-role: text;
                }
                if root.retry-enabled: retry := TileButton {
                    x: FocusTokens.outer-margin;
                    y: FocusTokens.outer-margin + root.retry-top(feedback-metrics.preferred-height);
                    width: max(0px, scroll.content-width - 2 * FocusTokens.outer-margin);
                    height: root.retry-height;
                    radius: 6px;
                    filled: false;
                    allow-return-repeat: false;
                    enabled: !root.loading && !root.action-pending;
                    accessible-text: @tr("Retry keyboard profiles");
                    clicked => { root.retry-requested(); }
                    focus-acquired => { root.reveal-focused(self.y, self.height); }
                    InputLanguageText {
                        x: 12px;
                        y: 8px;
                        width: max(0px, parent.width - 24px);
                        height: root.description-height;
                        text: @tr("Retry");
                        font-weight: 600;
                        line-height-factor: body.text-line-height-factor;
                        overflow: elide;
                    }
                }
            }
            // Native accessibility accommodation: Settings stays outside the
            // scroll viewport; the source scrolls the complete popup.
            footer := TileButton {
                in property <string> capability: root.settings-key;
                activation-key: root.settings-key;
                x: 8px;
                y: max(0px, body.content-height - root.actual-footer-height)
                    + min(root.inset-remainder, root.actual-footer-height);
                width: max(0px, body.content-width - 16px);
                height: max(0px, min(root.footer-button-height,
                    root.actual-footer-height - root.inset-remainder
                    - max(8px, FocusTokens.outer-margin)));
                radius: 6px;
                filled: false;
                allow-return-repeat: false;
                enabled: !root.action-pending && self.capability != "";
                accessible-text: @tr("More keyboard settings");
                clicked => { root.open-settings(self.capability); }
                InputLanguageText {
                    x: PopoverTokens.font-size * 0.5;
                    y: PopoverTokens.font-size * 0.25;
                    width: max(0px, parent.width - PopoverTokens.font-size);
                    height: max(0px, parent.height - PopoverTokens.font-size * 0.5);
                    text: @tr("More keyboard settings");
                    font-weight: 600;
                    color: SeelenPalette.secondary;
                    horizontal-alignment: center;
                    line-height-factor: body.text-line-height-factor;
                    overflow: elide;
                }
            }
        }
    }
}
