import { ScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { TileButton, FocusTokens } from "tiles.slint";
import { PopoverBody, PopoverTokens } from "popover.slint";
import { DockMenuKind, DockMenuAction } from "shell-commands.slint";

struct MenuEntry {
    label: string,
    action: DockMenuAction,
    icon: image,
    application-image: bool,
    danger: bool,
}

component MenuLabel inherits Text {
    color: SeelenPalette.foreground;
    font-size: PopoverTokens.font-size;
    font-family: PopoverTokens.font-family;
    font-weight: 600;
    accessible-role: none;
    // Only the button owns a label; metric instances must not match it.
    accessible-label: "";
}

component MenuIcon inherits Rectangle {
    in property <image> source;
    in property <bool> application-image;
    in property <color> tint;
    width: 16px;
    height: 16px;
    background: transparent;
    border-radius: root.application-image ? 4px : 0px;
    clip: root.application-image;
    accessible-role: none;
    // Clip real application pixels without applying the named SVG tint.
    if root.application-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: contain;
        accessible-role: none;
    }
    if !root.application-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: contain;
        colorize: root.tint;
        accessible-role: none;
    }
}

// A separate native Window: winit's built-in popups are clipped inside the
// parent bar, and its platform menu blocks the UI event loop.
export component ContextMenuSurface inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera context menu";
    min-width: 1px;
    min-height: 1px;
    in property <DockMenuKind> kind;
    in property <image> target-icon;
    in property <bool> recycle-empty-enabled: false;
    in-out property <int> selected-index;
    out property <length> menu-width: max(200px,
        plain-label-metrics.preferred-width + 32px,
        icon-label-metrics.preferred-width + 32px + 16px + 8px)
        + 2 * PopoverTokens.shadow-margin;
    out property <length> menu-height: 2 * PopoverTokens.shadow-margin + 16px + root.rows-height;
    preferred-width: root.menu-width;
    preferred-height: root.menu-height;
    property <length> row-height: PopoverTokens.font-size * PopoverTokens.line-height + 16px;
    property <length> row-gap: 8px;
    property <length> rows-height: root.entries.length * root.row-height
        + max(0, root.entries.length - 1) * root.row-gap;
    property <bool> keyboard-navigation;
    property <length> viewport-inset: max(0px, 8px - FocusTokens.outer-margin);
    callback action-requested(DockMenuAction);
    callback dismiss-requested();
    pure callback metric-labels([MenuEntry], bool) -> string;
    // Direct shared-font probes avoid deferred repeater layout before show.
    plain-label-metrics := MenuLabel {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.metric-labels(root.entries, false);
    }
    icon-label-metrics := MenuLabel {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: root.metric-labels(root.entries, true);
    }
    property <[MenuEntry]> entries: root.kind == DockMenuKind.bar ? [
        { label: @tr("Settings"), action: DockMenuAction.settings,
            icon: @image-url("../assets/icons/remix-6da3244/settings-4-fill.svg") },
        { label: @tr("File Explorer"), action: DockMenuAction.file-manager },
        { label: @tr("Task Manager"), action: DockMenuAction.task-manager },
        { label: @tr("Restore Explorer"), action: DockMenuAction.restore },
        { label: @tr("Exit Tessera"), action: DockMenuAction.exit }
    ] : root.kind == DockMenuKind.pinned ? [
        { label: @tr("Open"), action: DockMenuAction.launch,
            icon: root.target-icon.width > 0 ? root.target-icon :
                @image-url("../assets/icons/ionicons-5.5.4/open-outline.svg"),
            application-image: root.target-icon.width > 0 },
        { label: @tr("Unpin"), action: DockMenuAction.unpin }
    ] : root.kind == DockMenuKind.recycle ? [
        { label: @tr("Empty Recycle Bin"), action: DockMenuAction.recycle-empty, danger: true },
        { label: @tr("Retry"), action: DockMenuAction.recycle-retry }
    ] : [
        { label: @tr("Switch to window"), action: DockMenuAction.activate,
            icon: root.target-icon.width > 0 ? root.target-icon :
                @image-url("../assets/icons/ionicons-5.5.4/open-outline.svg"),
            application-image: root.target-icon.width > 0 },
        { label: @tr("Minimize"), action: DockMenuAction.minimize },
        { label: @tr("Close"), action: DockMenuAction.close,
            icon: @image-url("../assets/icons/boxicons-font-9ffa913/window-close.svg"), danger: true }
    ];

    pure function entry-enabled(index: int) -> bool {
        return index >= 0 && index < root.entries.length
            && (root.entries[index].action != DockMenuAction.recycle-empty
                || root.recycle-empty-enabled);
    }
    pure function adjacent-index(index: int, direction: int) -> int {
        return direction > 0
            ? (index >= root.entries.length - 1 ? 0 : index + 1)
            : (index <= 0 ? root.entries.length - 1 : index - 1);
    }
    pure function next-enabled-index(index: int, direction: int) -> int {
        let candidate = root.adjacent-index(index, direction);
        // Only Empty can be disabled; every scope retains an enabled row.
        return root.entry-enabled(candidate) ? candidate
            : root.adjacent-index(candidate, direction);
    }

    public function focus-menu() {
        root.keyboard-navigation = false;
        keyboard.focus();
    }
    public function set-presentation-opacity(value: float) {
        body.set-presentation-opacity(value);
    }
    forward-focus: keyboard;
    keyboard := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss-requested();
                return accept;
            }
            if event.text == Key.DownArrow || event.text == Key.UpArrow {
                root.selected-index = root.next-enabled-index(root.selected-index,
                    event.text == Key.DownArrow ? 1 : -1);
                root.keyboard-navigation = true;
                return accept;
            }
            if event.text == Key.Home || event.text == Key.End {
                root.selected-index = event.text == Key.Home
                    ? root.next-enabled-index(root.entries.length - 1, 1)
                    : root.next-enabled-index(0, -1);
                root.keyboard-navigation = true;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space)
                && (!root.entry-enabled(root.selected-index)
                    || (event.repeat
                        && root.entries[root.selected-index].action == DockMenuAction.recycle-empty)) {
                return accept;
            }
            if event.text == Key.Tab { return accept; }
            return reject;
        }
        key-pressed(event) => {
            if event.text == Key.Return || event.text == Key.Space {
                if root.entry-enabled(root.selected-index)
                    && !(event.repeat
                        && root.entries[root.selected-index].action == DockMenuAction.recycle-empty) {
                    root.action-requested(root.entries[root.selected-index].action);
                }
                return accept;
            }
            return reject;
        }

        body := PopoverBody {
            ScrollView {
                x: root.viewport-inset;
                y: root.viewport-inset;
                width: max(0px, body.content-width - 2 * root.viewport-inset);
                height: max(0px, body.content-height - 2 * root.viewport-inset);
                content-width: self.visible-width;
                content-height: root.rows-height + 2 * FocusTokens.outer-margin;
                content-y: -max(0px, min(root.selected-index * (root.row-height + root.row-gap),
                    self.content-height - self.visible-height));
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;
                for entry[index] in root.entries: Rectangle {
                    x: FocusTokens.outer-margin;
                    y: FocusTokens.outer-margin + index * (root.row-height + root.row-gap);
                    width: max(0px, parent.width - 2 * FocusTokens.outer-margin);
                    height: root.row-height;
                    TileButton {
                        width: parent.width;
                        height: parent.height;
                        y: self.pressed ? 1px : 0px;
                        transform-scale: self.pressed ? 0.98 : 1;
                        radius: 6px;
                        filled: false;
                        enabled: root.entry-enabled(index);
                        allow-return-repeat: entry.action != DockMenuAction.recycle-empty;
                        property <bool> has-icon: entry.icon.width > 0;
                        property <bool> keyboard-selected: root.keyboard-navigation
                            && root.selected-index == index;
                        changed keyboard-selected => {
                            if self.keyboard-selected { self.focus-for-keyboard(); }
                        }
                        background: self.pressed ? SeelenPalette.accent.with-alpha(0.3) :
                            self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
                        accessible-text: entry.label;
                        changed hovered => {
                            if self.hovered {
                                root.keyboard-navigation = false;
                                root.selected-index = index;
                            }
                        }
                        changed pressed => {
                            if self.pressed { root.keyboard-navigation = false; }
                        }
                        clicked => {
                            if root.entry-enabled(index) { root.action-requested(entry.action); }
                        }
                        if entry.icon.width > 0: MenuIcon {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            source: entry.icon;
                            application-image: entry.application-image;
                            tint: entry.danger ? SeelenPalette.danger : SeelenPalette.muted;
                        }
                        MenuLabel {
                            x: parent.has-icon ? 32px : 8px;
                            width: max(0px, parent.width - self.x - 8px);
                            text: entry.label;
                            color: entry.danger ? SeelenPalette.danger : SeelenPalette.foreground;
                            line-height-factor: body.text-line-height-factor;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
