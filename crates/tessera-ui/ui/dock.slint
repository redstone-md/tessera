import { ScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { ApplicationIcon, TileButton, TileBounds } from "tiles.slint";
import { DockWindowCommand, DockSystemCommand, DockReservedAction, DockRecycleState, DockRecycleAction, DockMenuKind } from "shell-commands.slint";
import { DockMediaTile, DockMediaView, MediaAction } from "dock-media.slint";

export struct DockApp { key: string, label: string, icon: image, pinned: bool }
export struct DockWindow { key: string, caption: string, icon: image }
export struct DockStatus { notice: string, status: string, refreshing: bool, stale: bool }



// One bounded floating dock bar, centered on the primary monitor bounds by
// the controller (MinContent by the actual tile count; overflow scrolls).
// Click targets are icon tiles with Seelen radius 10; running windows carry
// a 3px indicator, the focused window a half-tile accent indicator.
export component Dock inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera dock";
    min-width: 1px;
    min-height: 1px;

    in property <[DockApp]> pinned-apps;
    in property <[DockWindow]> running-windows;
    in property <DockStatus> surface-status;
    in property <string> focused-key;
    in property <bool> compact;
    in property <int> edge;
    in property <bool> show-desktop-busy;
    in property <string> show-desktop-notice;
    in property <DockRecycleState> recycle-state;
    in property <bool> recycle-read-busy;
    in property <bool> recycle-open-busy;
    in property <bool> recycle-stale;
    in property <string> recycle-item-count-label;
    in property <string> recycle-read-notice;
    in property <string> recycle-watch-notice;
    in property <string> recycle-open-notice;
    in-out property <bool> recycle-empty-busy: false;
    in-out property <bool> recycle-empty-enabled: false;
    in-out property <string> recycle-empty-notice: "";
    in-out property <DockMediaView> media-view;
    property <bool> vertical: root.edge >= 2;
    callback launch-requested(string);
    callback window-command-requested(string, DockWindowCommand);
    callback open-applications-requested();
    callback exit-requested();
    callback open-settings-requested();
    callback pin-toggle-requested(string, bool);
    callback system-command-requested(DockSystemCommand);
    callback reserved-action-requested(DockReservedAction);
    callback utility-event-ready();
    callback recycle-action-requested(DockRecycleAction);
    callback recycle-event-ready();
    callback recycle-projection-changed();
    callback media-action-requested(MediaAction);
    callback media-retry-requested();
    callback media-event-ready();
    callback media-context-requested(Point);
    callback media-enabled-requested(bool);
    changed recycle-empty-enabled => { root.recycle-projection-changed(); }
    callback context-menu-requested(DockMenuKind, string, Point);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point);

    // Seelen tokens (exact defaults; compact shrinks proportionally).
    property <float> factor: root.compact ? 0.8 : 1;
    property <length> item: 40px * root.factor;
    property <length> gap: 8px * root.factor;
    property <length> pad: 8px * root.factor;
    property <length> margin: 8px * root.factor;
    property <length> bar-radius: 16px * root.factor;
    property <length> tile-radius: 10px * root.factor;
    property <length> icon-pad: 6px * root.factor;
    property <bool> blocked: root.surface-status.refreshing || root.surface-status.stale;
    // Only confirmed projections carry counts. Notices retain independent
    // read/watch/open/empty health; the generic glyph does not certify emptiness.
    property <string> recycle-description: @tr("Recycle Bin") + "\n"
        + (root.recycle-state == DockRecycleState.unknown
            ? (root.recycle-read-busy ? @tr("Loading") : @tr("Unknown"))
            : root.recycle-item-count-label)
        + (root.recycle-stale ? "\n" + @tr("Stale") : "")
        + (root.recycle-read-notice == "" ? "" : "\n" + root.recycle-read-notice)
        + (root.recycle-watch-notice == "" ? "" : "\n" + root.recycle-watch-notice)
        + (root.recycle-open-notice == "" ? "" : "\n" + root.recycle-open-notice)
        + (root.recycle-empty-notice == "" ? "" : "\n" + root.recycle-empty-notice);
    property <length> media-length: root.media-view.enabled ? 136px * root.factor + root.gap : 0px;

    // The bar itself: an inner rounded rectangle inside the transparent
    // window's outer margin. Start/Show desktop lead, Trash trails, and only
    // application/window tiles scroll between these fixed utilities.
    Rectangle {
        x: root.margin;
        y: root.margin;
        width: max(0px, parent.width - 2 * root.margin);
        height: max(0px, parent.height - 2 * root.margin);
        border-radius: root.bar-radius;
        background: SeelenPalette.bar.with-alpha(0.8);
        clip: true;

        // The Start tile also exposes recovery commands while data is stale.
        TileButton {
            x: root.pad;
            y: root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            accessible-text: "Open applications and settings";
            tooltip-text: @tr("Applications");
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.open-applications-requested(); }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.bar, "", position);
            }
            // Bootstrap Icons (MIT), independent of Seelen assets.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/bootstrap-icons-1.13.1/windows.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }

        TileButton {
            x: root.vertical ? root.pad : root.pad + root.item + root.gap;
            y: root.vertical ? root.pad + root.item + root.gap : root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            enabled: !root.show-desktop-busy;
            allow-return-repeat: false;
            accessible-text: "Show desktop";
            tooltip-text: @tr("Show desktop") + (root.show-desktop-notice == "" ? "" : "\n" + root.show-desktop-notice);
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.reserved-action-requested(DockReservedAction.show-desktop); }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.bar, "", position);
            }
            // Phosphor Icons (MIT), independently imported unmodified artwork.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/phosphor-core-2.1.1/desktop-duotone.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }

        scroll := ScrollView {
            x: root.vertical ? root.pad : root.pad + 2 * (root.item + root.gap);
            y: root.vertical ? root.pad + 2 * (root.item + root.gap) : root.pad;
            width: max(0px, parent.width - 2 * root.pad - (root.vertical ? 0px : 3 * (root.item + root.gap)));
            height: max(0px, parent.height - 2 * root.pad - (root.vertical ? 3 * (root.item + root.gap) : 0px));
            // Desktop tiles own button-down; overflow uses wheel/scrollbars,
            // not a competing mouse-pan gesture that delays those events.
            mouse-drag-pan-enabled: false;
            horizontal-scrollbar-policy: root.vertical ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
            vertical-scrollbar-policy: root.vertical ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
            property <length> content-length: max(0px,
                (root.pinned-apps.length + root.running-windows.length) * (root.item + root.gap) - root.gap + root.media-length);
            content-width: root.vertical ? self.visible-width : max(self.visible-width, self.content-length);
            content-height: root.vertical ? max(self.visible-height, self.content-length) : self.visible-height;


            if root.media-view.enabled: DockMediaTile {
                x: 0px;
                y: 0px;
                view: root.media-view;
                compact: root.compact;
                edge: root.edge;
                command-requested(action) => { root.media-action-requested(action); }
                retry-requested => { root.media-retry-requested(); }
                context-requested(point) => { root.media-context-requested(point); }
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            }
            // Tiles: pinned applications first, then running windows.
            for tile[i] in root.pinned-apps: Rectangle {
                property <length> step: root.item + root.gap;
                property <length> offset: root.media-length + i * step;
                x: root.vertical ? 0px : self.offset;
                y: root.vertical ? self.offset : 0px;
                width: root.item;
                height: root.item;
                clip: false;

                TileButton {
                    width: parent.width;
                    height: parent.height;
                    radius: root.tile-radius;
                    enabled: !root.blocked;
                    accessible-text: "Launch " + tile.label;
                    tooltip-text: tile.label;
                    tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                    tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                    clicked => { root.launch-requested(tile.key); }
                    middle-clicked => { root.launch-requested(tile.key); }
                    context-requested(position) => {
                        root.context-menu-requested(DockMenuKind.pinned, tile.key, position);
                    }

                    ApplicationIcon {
                        x: root.icon-pad;
                        y: root.icon-pad;
                        width: parent.width - 2 * root.icon-pad;
                        height: parent.height - 2 * root.icon-pad;
                        source: tile.icon;
                        accessible-role: none;
                    }
                }
            }
            for tile[i] in root.running-windows: Rectangle {
                property <length> step: root.item + root.gap;
                property <length> offset: root.media-length + (root.pinned-apps.length + i) * step;
                property <bool> focused: tile.key == root.focused-key;
                x: root.vertical ? 0px : self.offset;
                y: root.vertical ? self.offset : 0px;
                width: root.item;
                height: root.item;
                clip: false;

                TileButton {
                    width: parent.width;
                    height: parent.height;
                    radius: root.tile-radius;
                    enabled: !root.blocked;
                    accessible-text: "Switch to " + tile.caption;
                    tooltip-text: tile.caption;
                    tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                    tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                    clicked => { root.window-command-requested(tile.key, DockWindowCommand.toggle); }
                    context-requested(position) => {
                        root.context-menu-requested(DockMenuKind.window, tile.key, position);
                    }

                    ApplicationIcon {
                        x: root.icon-pad;
                        y: root.icon-pad;
                        width: parent.width - 2 * root.icon-pad;
                        height: parent.height - 2 * root.icon-pad;
                        source: tile.icon;
                        accessible-role: none;
                    }
                }
                // Running indicator: 3px dot on the outer edge; the focused
                // window's indicator widens to half the tile in the accent.
                Rectangle {
                    property <length> indicator: parent.focused ? root.item / 2 : 3px;
                    width: root.vertical ? 3px : self.indicator;
                    height: root.vertical ? self.indicator : 3px;
                    border-radius: 999px;
                    background: parent.focused ? SeelenPalette.accent : SeelenPalette.muted;
                    x: root.edge == 2 ? 0px : root.edge == 3 ? parent.width - self.width : (parent.width - self.width) / 2;
                    y: root.edge == 1 ? 0px : root.edge == 0 ? parent.height - self.height : (parent.height - self.height) / 2;
                    visible: !root.surface-status.refreshing;
                    accessible-role: none;
                }
            }
        }

        // Literal trailing utility: declaration/Tab order follows all apps.
        TileButton {
            x: root.vertical ? root.pad : max(root.pad, parent.width - root.pad - root.item);
            y: root.vertical ? max(root.pad, parent.height - root.pad - root.item) : root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            allow-return-repeat: false;
            accessible-text: root.recycle-description;
            tooltip-text: root.recycle-description;
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => {
                if !root.recycle-open-busy {
                    root.recycle-action-requested(DockRecycleAction.open);
                }
            }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.recycle, "", position);
            }
            // Independent MIT identity mark, identical for Unknown/Empty/Full.
            // Exact source full/empty state artwork remains uncleared.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/phosphor-core-2.1.1/trash-duotone.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }
    }
}
