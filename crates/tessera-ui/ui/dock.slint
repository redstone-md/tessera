import { ScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { ApplicationIcon, TileButton, TileBounds } from "tiles.slint";
import { DockWindowCommand, DockSystemCommand, DockReservedAction, DockRecycleState, DockRecycleAction, DockMenuKind } from "shell-commands.slint";
import { DockMediaTile, DockMediaView, MediaAction } from "dock-media.slint";

export struct DockApp { key: string, label: string, icon: image, pinned: bool }
export struct DockWindow { key: string, caption: string, icon: image }
export struct DockGroup { key: string, identity: string, count: int, representative: string }
export struct DockStatus { notice: string, status: string, refreshing: bool, stale: bool }
export struct DockTileAppearance {
    reference-mode: bool, tile-color: color, hover-color: color,
    pressed-color: color, foreground: color, icon-pad: length, radius: length
}
export struct DockDragVisual {
    visible: bool, source: DockApp, count: int, pressed: bool,
    appearance: DockTileAppearance, bounds: TileBounds
}
export struct DockOrderMetrics { viewport: TileBounds, vertical: bool, edge: int }


// Keep the action/input slot fixed while only ordinary tile paint moves.
// Media deliberately retains its separate, stationary interaction treatment.
component DockButton inherits TileButton {
    in property <bool> paint-pressed: root.pressed;
    in property <DockTileAppearance> appearance: {
        reference-mode: SeelenPalette.reference-mode,
        tile-color: SeelenPalette.tile, hover-color: SeelenPalette.hover,
        pressed-color: SeelenPalette.pressed, foreground: SeelenPalette.foreground,
        icon-pad: 6.5px, radius: root.radius
    };
    background: transparent;
    Rectangle {
        y: root.paint-pressed ? 2px : 0px;
        width: root.width;
        height: root.height;
        border-radius: root.radius;
        background: root.appearance.reference-mode
            ? (root.enabled && (root.hovered || root.paint-pressed) ? root.appearance.hover-color : root.appearance.tile-color)
            : (!root.enabled ? transparent :
                root.paint-pressed ? root.appearance.pressed-color :
                root.hovered ? root.appearance.hover-color : transparent);
        drop-shadow-color: root.appearance.reference-mode ? #000000.with-alpha(0.08) : transparent;
        drop-shadow-offset-x: 1px;
        drop-shadow-offset-y: 1px;
        drop-shadow-blur: 2px;
        accessible-role: none;
        @children
    }
}
// The real source and passive feedback use exactly the same tile paint.
component DockApplicationButton inherits DockButton {
    in property <DockApp> app;
    in property <int> count;
    accessible-role: button;
    ApplicationIcon {
        x: root.appearance.icon-pad;
        y: root.appearance.icon-pad;
        width: parent.width - 2 * root.appearance.icon-pad;
        height: parent.height - 2 * root.appearance.icon-pad;
        source: root.app.icon;
        accessible-role: none;
    }
    if root.count > 0: Text {
        x: parent.width - self.width - 2px;
        y: parent.height - self.height;
        text: root.count;
        font-size: 11px;
        color: root.appearance.foreground;
        accessible-role: none;
    }
}
component DockIndicator inherits Rectangle {
    in property <bool> focused;
    in property <int> edge;
    in property <length> item;
    in property <length> pad;
    in property <length> offset;
    in property <length> content-x;
    in property <length> content-y;
    property <bool> vertical: root.edge >= 2;
    property <length> indicator: root.focused ? root.item / 2 : 3px;
    width: root.vertical ? 3px : root.indicator;
    height: root.vertical ? root.indicator : 3px;
    border-radius: 999px;
    background: root.focused ? SeelenPalette.accent : SeelenPalette.running-indicator;
    x: root.vertical
        ? (root.edge == 2 ? root.pad / 2 : root.pad + root.item + root.pad / 2) - self.width / 2
        : root.offset + root.content-x + (root.item - self.width) / 2;
    y: root.vertical
        ? root.offset + root.content-y + (root.item - self.height) / 2
        : (root.edge == 1 ? root.pad / 2 : root.pad + root.item + root.pad / 2) - self.height / 2;
    accessible-role: none;
}



// One bounded floating dock bar, centered on the primary monitor bounds by
// the controller (MinContent by the actual tile count; overflow scrolls).
// Source-informed 46px fixed slots surround 33px icons; only paint moves.
// Running/focused indicators stay on the existing independent edge rail.
export component Dock inherits Window {
    default-font-family: SeelenPalette.font-family;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera dock";
    min-width: 1px;
    min-height: 1px;

    in property <[DockApp]> pinned-apps;
    in property <[DockWindow]> running-windows;
    in property <[DockWindow]> observed-windows;
    in property <[DockGroup]> group-metadata;
    pure callback group-count([DockGroup], string) -> int;
    pure callback group-tooltip([DockWindow], [DockGroup], string) -> string;
    in property <DockStatus> surface-status;
    in property <string> focused-key;
    in property <bool> compact;
    in property <int> edge;
    in property <bool> show-desktop-busy;
    in property <string> show-desktop-notice;
    in property <DockRecycleState> recycle-state;
    in property <bool> recycle-read-busy;
    in property <bool> recycle-open-busy;
    in property <bool> recycle-stale;
    in property <string> recycle-item-count-label;
    in property <string> recycle-read-notice;
    in property <string> recycle-watch-notice;
    in property <string> recycle-open-notice;
    in-out property <bool> recycle-empty-busy: false;
    in-out property <bool> recycle-empty-enabled: false;
    in-out property <string> recycle-empty-notice: "";
    in-out property <DockMediaView> media-view;
    property <bool> vertical: root.edge >= 2;
    callback launch-requested(string);
    callback activate-app-requested(string);
    // Native Root-owned action admission; legacy docks retain new-instance launch.
    in-out property <bool> middle-click-available: false;
    in-out property <string> middle-click-label: "New instance";
    callback middle-click-pointer(string, bool, PointerEvent, TileBounds, Point);
    callback middle-click-requested(string, bool);
    out property <Point> middle-click-scroll: { x: scroll.content-x, y: scroll.content-y };
    callback middle-click-frame-changed();
    changed middle-click-scroll => { root.middle-click-frame-changed(); }
    callback window-command-requested(string, DockWindowCommand);
    callback open-applications-requested();
    callback exit-requested();
    callback open-settings-requested();
    callback pin-toggle-requested(string, bool);
    callback system-command-requested(DockSystemCommand);
    callback reserved-action-requested(DockReservedAction);
    callback utility-event-ready();
    callback recycle-action-requested(DockRecycleAction);
    callback recycle-event-ready();
    callback recycle-projection-changed();
    callback media-action-requested(MediaAction);
    callback media-retry-requested();
    callback media-event-ready();
    callback media-context-requested(Point);
    callback media-enabled-requested(bool);
    changed recycle-empty-enabled => { root.recycle-projection-changed(); }
    callback context-menu-requested(DockMenuKind, string, Point);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point);
    in-out property <bool> reorder-enabled;
    // Only the native order controller grants this capability; legacy docks
    // retain their original menus even when ordinary pin callbacks are wired.
    in-out property <bool> reorder-lock-available: false;
    in-out property <bool> reorder-lock-enabled: false;
    in-out property <bool> reorder-locked: false;
    callback reorder-lock-requested(bool);
    in-out property <data-transfer> reorder-data;
    in-out property <DockDragVisual> reorder-visual;
    in-out property <string> reorder-target-key;
    in-out property <int> reorder-projection;
    out property <bool> reorder-dragging: pinned-drag.dragging;
    out property <DockOrderMetrics> reorder-metrics: {
        viewport: { origin: scroll.absolute-position,
            width: scroll.visible-width, height: scroll.visible-height },
        vertical: root.vertical, edge: root.edge
    };
    callback reorder-origin(DockDragVisual, PointerEvent, TileBounds, Point);
    callback reorder-slot-measured(string, TileBounds, int);
    callback reorder-dragging-changed(bool);
    callback reorder-can-drop(DropEvent, Point) -> DragAction;
    callback reorder-window-hover(DropEvent, Point);
    callback reorder-dropped(DropEvent, Point) -> DragAction;
    callback reorder-finished(DragAction);
    callback reorder-metrics-changed();
    callback reorder-move-requested(string, bool); // true means later in saved order
    changed reorder-metrics => { root.reorder-metrics-changed(); }

    // Chosen native Material3 geometry; compact shrinks proportionally.
    // Keep item/pad/gap/margin synchronized with src/dock.rs placement.
    property <float> factor: root.compact ? 0.8 : 1;
    property <length> item: 46px * root.factor;
    property <length> gap: 3px * root.factor;
    property <length> pad: 5px * root.factor;
    property <length> margin: 5px * root.factor;
    property <length> bar-radius: 23px * root.factor;
    property <length> tile-radius: 17px * root.factor;
    property <length> icon-pad: 6.5px * root.factor;
    property <bool> blocked: root.surface-status.refreshing || root.surface-status.stale;
    // Only confirmed projections carry counts. Notices retain independent
    // read/watch/open/empty health; the generic glyph does not certify emptiness.
    property <string> recycle-description: @tr("Recycle Bin") + "\n"
        + (root.recycle-state == DockRecycleState.unknown
            ? (root.recycle-read-busy ? @tr("Loading") : @tr("Unknown"))
            : root.recycle-item-count-label)
        + (root.recycle-stale ? "\n" + @tr("Stale") : "")
        + (root.recycle-read-notice == "" ? "" : "\n" + root.recycle-read-notice)
        + (root.recycle-watch-notice == "" ? "" : "\n" + root.recycle-watch-notice)
        + (root.recycle-open-notice == "" ? "" : "\n" + root.recycle-open-notice)
        + (root.recycle-empty-notice == "" ? "" : "\n" + root.recycle-empty-notice);
    property <length> media-length: root.media-view.enabled ? 136px * root.factor + root.gap : 0px;

    // A window-sized passive hover target preserves feedback outside the
    // clipped strip. Only the measured pinned slots below authorize a drop.
    DropArea {
        x: 0px; y: 0px;
        width: root.width; height: root.height;
        enabled: root.reorder-enabled && root.reorder-dragging;
        can-drop(event) => {
            root.reorder-window-hover(event, self.absolute-position);
            return DragAction.none;
        }
        dropped(event) => { return DragAction.none; }
    }
    // The bar itself: an inner rounded rectangle inside the transparent
    // window's outer margin. Start/Show desktop lead, Trash trails, and only
    // application/window tiles scroll between these fixed utilities.
    Rectangle {
        x: root.margin;
        y: root.margin;
        width: max(0px, parent.width - 2 * root.margin);
        height: max(0px, parent.height - 2 * root.margin);
        border-radius: root.bar-radius;
        background: SeelenPalette.reference-mode ? SeelenPalette.bar.with-alpha(0.8) : SeelenPalette.surface-container;
        border-width: SeelenPalette.reference-mode ? 0px : 1px;
        border-color: SeelenPalette.outline-variant;
        clip: true;

        // The Start tile also exposes recovery commands while data is stale.
        DockButton {
            x: root.pad;
            y: root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            accessible-text: "Open applications and settings";
            tooltip-text: @tr("Applications");
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.open-applications-requested(); }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.bar, "", position);
            }
            // Bootstrap Icons (MIT), independent of Seelen assets.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/bootstrap-icons-1.13.1/windows.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }

        DockButton {
            x: root.vertical ? root.pad : root.pad + root.item + root.gap;
            y: root.vertical ? root.pad + root.item + root.gap : root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            enabled: !root.show-desktop-busy;
            allow-return-repeat: false;
            accessible-text: "Show desktop";
            tooltip-text: @tr("Show desktop") + (root.show-desktop-notice == "" ? "" : "\n" + root.show-desktop-notice);
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.reserved-action-requested(DockReservedAction.show-desktop); }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.bar, "", position);
            }
            // Phosphor Icons (MIT), independently imported unmodified artwork.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/phosphor-core-2.1.1/desktop-duotone.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }

        scroll := ScrollView {
            // Reserve the existing cross-axis bar padding inside the clipped
            // viewport. Compensating content offsets keep every tile/input
            // slot unchanged and let indicators/shadows paint outside it.
            x: root.vertical ? 0px : root.pad + 2 * (root.item + root.gap);
            y: root.vertical ? root.pad + 2 * (root.item + root.gap) : 0px;
            width: max(0px, parent.width - (root.vertical ? 0px : 2 * root.pad + 3 * (root.item + root.gap)));
            height: max(0px, parent.height - (root.vertical ? 2 * root.pad + 3 * (root.item + root.gap) : 0px));
            // Desktop tiles own button-down; overflow uses wheel/scrollbars,
            // not a competing mouse-pan gesture that delays those events.
            mouse-drag-pan-enabled: false;
            horizontal-scrollbar-policy: root.vertical ? ScrollBarPolicy.always-off : ScrollBarPolicy.as-needed;
            vertical-scrollbar-policy: root.vertical ? ScrollBarPolicy.as-needed : ScrollBarPolicy.always-off;
            property <length> content-length: max(0px,
                (root.pinned-apps.length + root.running-windows.length) * (root.item + root.gap) - root.gap + root.media-length);
            content-width: root.vertical ? self.visible-width : max(self.visible-width, self.content-length);
            content-height: root.vertical ? max(self.visible-height, self.content-length) : self.visible-height;


            if root.media-view.enabled: DockMediaTile {
                x: root.vertical ? root.pad : 0px;
                y: root.vertical ? 0px : root.pad;
                view: root.media-view;
                compact: root.compact;
                edge: root.edge;
                command-requested(action) => { root.media-action-requested(action); }
                retry-requested => { root.media-retry-requested(); }
                context-requested(point) => { root.media-context-requested(point); }
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            }
            // Tiles: pinned applications first, then running windows.
            pinned-drag := DragArea {
                x: root.vertical ? root.pad : root.media-length;
                y: root.vertical ? root.media-length : root.pad;
                width: root.vertical ? root.item : max(0px, root.pinned-apps.length * (root.item + root.gap) - root.gap);
                height: root.vertical ? max(0px, root.pinned-apps.length * (root.item + root.gap) - root.gap) : root.item;
                enabled: root.reorder-enabled && !root.blocked;
                data: root.reorder-data;
                allow-move: true;
                changed dragging => { root.reorder-dragging-changed(self.dragging); }
                drag-finished(action) => { root.reorder-finished(action); }
            DropArea {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                enabled: root.reorder-enabled && !root.blocked;
                can-drop(event) => { return root.reorder-can-drop(event, self.absolute-position); }
                dropped(event) => { return root.reorder-dropped(event, self.absolute-position); }
            for tile[i] in root.pinned-apps: Rectangle {
                property <length> step: root.item + root.gap;
                property <length> offset: i * step;
                x: root.vertical ? 0px : self.offset;
                y: root.vertical ? self.offset : 0px;
                width: root.item;
                height: root.item;
                clip: false;
                property <TileBounds> slot-bounds: {
                    origin: self.absolute-position, width: self.width, height: self.height
                };
                property <string> slot-key: tile.key;
                property <int> measurement-revision: root.reorder-projection;
                init => { root.reorder-slot-measured(self.slot-key, self.slot-bounds, self.measurement-revision); }
                changed slot-bounds => { root.reorder-slot-measured(self.slot-key, self.slot-bounds, self.measurement-revision); }
                changed slot-key => { root.reorder-slot-measured(self.slot-key, self.slot-bounds, self.measurement-revision); }
                changed measurement-revision => { root.reorder-slot-measured(self.slot-key, self.slot-bounds, self.measurement-revision); }
                if root.reorder-target-key == tile.key: Rectangle {
                    border-width: 2px;
                    border-color: SeelenPalette.accent;
                    border-radius: root.tile-radius;
                    accessible-role: none;
                }

                DockApplicationButton {
                    width: parent.width;
                    height: parent.height;
                    radius: root.tile-radius;
                    enabled: !root.blocked;
                    app: tile;
                    count: root.group-count(root.group-metadata, tile.key);
                    appearance: {
                        reference-mode: SeelenPalette.reference-mode,
                        tile-color: SeelenPalette.tile, hover-color: SeelenPalette.hover,
                        pressed-color: SeelenPalette.pressed, foreground: SeelenPalette.foreground,
                        icon-pad: root.icon-pad, radius: root.tile-radius
                    };
                    report-pointer-metadata: true;
                    pointer-metadata(event, bounds, point) => {
                        if root.middle-click-available {
                            root.middle-click-pointer(tile.key, true, event, bounds, point);
                        }
                        if event.button != PointerEventButton.middle {
                            root.reorder-origin({
                                visible: false, source: tile, count: self.count,
                                pressed: self.pressed, appearance: self.appearance, bounds: bounds
                            }, event, bounds, point);
                        }
                    }
                    opacity: root.reorder-visual.visible && root.reorder-visual.source.key == tile.key ? 0.35 : 1;
                    activation-key: tile.key;
                    accessible-text: (root.group-count(root.group-metadata, tile.key) > 0 ? "Switch to " : "Launch ") + tile.label;
                    tooltip-text: tile.label + root.group-tooltip(root.observed-windows, root.group-metadata, tile.key)
                        + (root.middle-click-available ? "\n" + @tr("Middle click") + ": " + root.middle-click-label : "");
                    tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                    tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                    clicked => {
                        if root.group-count(root.group-metadata, tile.key) > 1 {
                            root.context-menu-requested(DockMenuKind.pinned, tile.key, self.absolute-position);
                        } else if root.group-count(root.group-metadata, tile.key) == 1 { root.activate-app-requested(tile.key); }
                        else { root.launch-requested(tile.key); }
                    }
                    middle-clicked => {
                        if root.middle-click-available { root.middle-click-requested(tile.key, true); }
                        else { root.launch-requested(tile.key); }
                    }
                    context-requested(position) => {
                        root.context-menu-requested(DockMenuKind.pinned, tile.key, position);
                    }
                }
            }
            }
            }
            for tile[i] in root.running-windows: Rectangle {
                property <length> step: root.item + root.gap;
                property <length> offset: root.media-length + (root.pinned-apps.length + i) * step;
                x: root.vertical ? root.pad : self.offset;
                y: root.vertical ? self.offset : root.pad;
                width: root.item;
                height: root.item;
                clip: false;

                DockButton {
                    width: parent.width;
                    height: parent.height;
                    radius: root.tile-radius;
                    enabled: !root.blocked;
                    activation-key: tile.key;
                    report-pointer-metadata: root.middle-click-available;
                    pointer-metadata(event, bounds, point) => {
                        root.middle-click-pointer(tile.key, false, event, bounds, point);
                    }
                    accessible-text: "Switch to " + tile.caption;
                    tooltip-text: tile.caption
                        + (root.middle-click-available ? "\n" + @tr("Middle click") + ": " + root.middle-click-label : "");
                    tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                    tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                    clicked => {
                        if root.group-count(root.group-metadata, tile.key) > 1 {
                            root.context-menu-requested(DockMenuKind.window, tile.key, self.absolute-position);
                        } else { root.window-command-requested(tile.key, DockWindowCommand.toggle); }
                    }
                    middle-clicked => {
                        if root.middle-click-available { root.middle-click-requested(tile.key, false); }
                    }
                    context-requested(position) => {
                        root.context-menu-requested(DockMenuKind.window, tile.key, position);
                    }

                    ApplicationIcon {
                        x: root.icon-pad;
                        y: root.icon-pad;
                        width: parent.width - 2 * root.icon-pad;
                        height: parent.height - 2 * root.icon-pad;
                        source: tile.icon;
                        accessible-role: none;
                    }
                    if root.group-count(root.group-metadata, tile.key) > 1: Text {
                        x: parent.width - self.width - 2px;
                        y: parent.height - self.height;
                        text: root.group-count(root.group-metadata, tile.key);
                        font-size: 11px;
                        color: SeelenPalette.foreground;
                        accessible-role: none;
                    }
                }
            }
        }

        // The indicator rail shares the real scroll offset and clips only
        // along the scrolling axis. Native scrollbars cannot clip its outer
        // padding, and pressed tile paint never moves it.
        Rectangle {
            x: scroll.x;
            y: scroll.y;
            width: root.vertical ? parent.width : scroll.visible-width;
            height: root.vertical ? scroll.visible-height : parent.height;
            clip: true;
            accessible-role: none;
            for tile[i] in root.pinned-apps: DockIndicator {
                focused: tile.key == root.focused-key;
                edge: root.edge;
                item: root.item;
                pad: root.pad;
                offset: root.media-length + i * (root.item + root.gap);
                content-x: scroll.content-x;
                content-y: scroll.content-y;
                visible: !root.surface-status.refreshing && root.group-count(root.group-metadata, tile.key) > 0;
            }
            for tile[i] in root.running-windows: DockIndicator {
                focused: tile.key == root.focused-key;
                edge: root.edge;
                item: root.item;
                pad: root.pad;
                offset: root.media-length + (root.pinned-apps.length + i) * (root.item + root.gap);
                content-x: scroll.content-x;
                content-y: scroll.content-y;
                visible: !root.surface-status.refreshing;
            }
        }

        // Literal trailing utility: declaration/Tab order follows all apps.
        DockButton {
            x: root.vertical ? root.pad : max(root.pad, parent.width - root.pad - root.item);
            y: root.vertical ? max(root.pad, parent.height - root.pad - root.item) : root.pad;
            width: root.item;
            height: root.item;
            radius: root.tile-radius;
            allow-return-repeat: false;
            accessible-text: root.recycle-description;
            tooltip-text: root.recycle-description;
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => {
                if !root.recycle-open-busy {
                    root.recycle-action-requested(DockRecycleAction.open);
                }
            }
            context-requested(position) => {
                root.context-menu-requested(DockMenuKind.recycle, "", position);
            }
            // Independent MIT identity mark, identical for Unknown/Empty/Full.
            // Exact source full/empty state artwork remains uncleared.
            Image {
                x: root.icon-pad;
                y: root.icon-pad;
                width: parent.width - 2 * root.icon-pad;
                height: parent.height - 2 * root.icon-pad;
                source: @image-url("../assets/icons/phosphor-core-2.1.1/trash-duotone.svg");
                image-fit: contain;
                colorize: SeelenPalette.foreground;
                accessible-role: none;
            }
        }
    }
    // Outside both bar and ScrollView clipping; no input/AX/launch authority.
    if root.reorder-visual.visible: DockApplicationButton {
        x: root.reorder-visual.bounds.origin.x;
        y: root.reorder-visual.bounds.origin.y;
        width: root.reorder-visual.bounds.width;
        height: root.reorder-visual.bounds.height;
        radius: root.reorder-visual.appearance.radius;
        app: root.reorder-visual.source;
        count: root.reorder-visual.count;
        appearance: root.reorder-visual.appearance;
        paint-pressed: root.reorder-visual.pressed;
        interactive: false;
        accessible-role: none;
        show-focus-ring: false;
    }
}
