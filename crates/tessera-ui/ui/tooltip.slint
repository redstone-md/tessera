import { SeelenPalette } from "palette.slint";
import { PopoverBody, PopoverTokens } from "popover.slint";

// A native top-level surface. The host supplies NOACTIVATE and documented
// cursor pass-through; no FocusScope, TouchArea, or actions live here.
export component TooltipSurface inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera tooltip";
    min-width: 1px;
    min-height: 1px;

    in property <string> content;
    in property <length> max-content-width: 500px;
    property <length> body-width: min(root.max-content-width, max(16px, label.preferred-width + 16px));
    out property <length> tooltip-width: root.body-width + 2 * PopoverTokens.shadow-margin;
    out property <length> tooltip-height: max(1px, label.preferred-height + 8px) + 2 * PopoverTokens.shadow-margin;
    preferred-width: root.tooltip-width;
    preferred-height: root.tooltip-height;
    public function set-presentation-opacity(value: float) {
        body.set-presentation-opacity(value);
    }

    body := PopoverBody {
        label := Text {
            x: 8px;
            y: 4px;
            // Measure against the intended body width, even before the native
            // window receives its first physical size.
            width: max(0px, root.body-width - 16px);
            height: max(0px, body.content-height - 8px);
            text: root.content;
            color: SeelenPalette.foreground;
            font-size: PopoverTokens.font-size;
            font-family: PopoverTokens.font-family;
            line-height-factor: body.text-line-height-factor;
            vertical-alignment: center;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: root.content;
        }
    }
}
