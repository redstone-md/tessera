import { ScrollView as NativeScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { TileButton, FocusTokens } from "tiles.slint";
import { PopoverBody, PopoverTokens, PopoverMotion } from "popover.slint";

export enum PowerMenuAction { LockSession }

// This window covers the physical desktop aggregate. Its controller supplies
// the selected full monitor in this window's CURRENT logical coordinate space.
export component PowerMenuSurface inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera power menu";
    min-width: 0px;
    min-height: 0px;
    preferred-width: 1px;
    preferred-height: 1px;
    in property <length> selected-x;
    in property <length> selected-y;
    in property <length> selected-width;
    in property <length> selected-height;
    // Display presentation scale already includes native text scale.
    in property <float> metric-scale: 1;
    in property <bool> action-enabled: true;
    in property <bool> lock-busy: false;
    callback action-requested(PowerMenuAction);
    callback hide-requested();
    // UI-thread wakeup only; neither callback carries native action authority.
    callback power-event-ready();
    callback viewport-changed();
    changed width => { root.viewport-changed(); }
    changed height => { root.viewport-changed(); }

    property <length> font-size: PopoverTokens.font-size * root.metric-scale;
    property <length> text-height: root.font-size * PopoverTokens.line-height;
    property <float> text-line-height-factor: font-probe.preferred-height > 0px
        ? root.text-height / font-probe.preferred-height : 1;
    property <length> action-size: 100px * root.metric-scale;
    property <length> focus-margin: FocusTokens.outer-margin;
    property <length> content-padding: min(24px * root.metric-scale,
        max(root.focus-margin, selected-viewport.width / 6),
        max(root.focus-margin, selected-viewport.height / 6));
    property <length> natural-height: 2 * root.content-padding + root.text-height
        + 24px * root.metric-scale + root.action-size;
    // Keep source shadow space on ordinary monitors; tiny viewports prioritize
    // a scrollable real control instead of consuming their extent with shadow.
    property <length> shadow-space: min(32px * root.metric-scale,
        max(0px, (selected-viewport.width - 124px * root.metric-scale) / 2),
        max(0px, (selected-viewport.height - 124px * root.metric-scale) / 2));

    font-probe := Text {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: "M";
        font-size: root.font-size;
        font-family: PopoverTokens.font-family;
        accessible-role: none;
    }
    public function set-presentation-opacity(value: float) {
        body.set-presentation-opacity(value);
    }
    public function focus-content() {
        scroll.content-x = 0px;
        scroll.content-y = 0px;
        escape-scope.focus();
    }
    function reveal-lock() {
        let left = lock.x - root.focus-margin;
        let right = lock.x + lock.width + root.focus-margin;
        let top = lock.y - root.focus-margin;
        let bottom = lock.y + lock.height + root.focus-margin;
        if left < -scroll.content-x {
            scroll.content-x = -max(0px, left);
        } else if right > -scroll.content-x + scroll.visible-width {
            scroll.content-x = -max(0px, min(right - scroll.visible-width,
                scroll.content-width - scroll.visible-width));
        }
        if top < -scroll.content-y {
            scroll.content-y = -max(0px, top);
        } else if bottom > -scroll.content-y + scroll.visible-height {
            scroll.content-y = -max(0px, min(bottom - scroll.visible-height,
                scroll.content-height - scroll.visible-height));
        }
    }
    forward-focus: escape-scope;

    escape-scope := FocusScope {
        width: root.width;
        height: root.height;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.hide-requested();
                return accept;
            }
            return reject;
        }
        scrim := Rectangle {
            width: parent.width;
            height: parent.height;
            background: #12121266;
            accessible-role: none;
            TouchArea {
                clicked => { root.hide-requested(); }
            }
        }
        selected-viewport := Rectangle {
            x: root.selected-x;
            y: root.selected-y;
            width: max(0px, min(root.selected-width, root.width - self.x));
            height: max(0px, min(root.selected-height, root.height - self.y));
            accessible-role: none;
            body := PopoverBody {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(parent.width, 396px * root.metric-scale + 2 * root.shadow-space);
                height: min(parent.height, root.natural-height + 2 * root.shadow-space);
                shadow-margin: root.shadow-space;
                surface-radius: 16px * root.metric-scale;
                // Power's bg-light role differs from the standard popup role.
                surface-background: SeelenPalette.tile;
                surface-shadow-color: #0000003d;
                surface-shadow-offset-x: 8px * root.metric-scale;
                surface-shadow-offset-y: 8px * root.metric-scale;
                surface-shadow-blur: 24px * root.metric-scale;
                // Consume body input before the desktop scrim, without creating
                // a second action, focus target, account or confirmation route.
                TouchArea { clicked => { } }
                scroll := NativeScrollView {
                    width: body.content-width;
                    height: body.content-height;
                    horizontal-scrollbar-policy: as-needed;
                    vertical-scrollbar-policy: as-needed;
                    content-width: max(self.visible-width,
                        root.action-size + 2 * root.content-padding);
                    content-height: root.natural-height;
                    Text {
                        x: root.content-padding;
                        y: root.content-padding;
                        width: max(0px, parent.width - 2 * root.content-padding);
                        height: root.text-height;
                        text: root.lock-busy ? @tr("Lock request pending") : @tr("Power menu");
                        font-size: root.font-size;
                        font-family: PopoverTokens.font-family;
                        line-height-factor: root.text-line-height-factor;
                        font-weight: 600;
                        color: SeelenPalette.foreground;
                        overflow: elide;
                        accessible-role: text;
                        accessible-label: self.text;
                    }
                    lock := TileButton {
                        x: root.content-padding;
                        y: root.content-padding + root.text-height + 24px * root.metric-scale
                            + (self.enabled && self.hovered && !self.pressed ? -4px * root.metric-scale : 0px);
                        width: root.action-size;
                        height: root.action-size;
                        radius: 10px * root.metric-scale;
                        // Paint-only scale preserves the source's stable 100px layout.
                        transform-scale: !self.enabled ? 1 : self.pressed ? 0.95 : self.hovered ? 1.05 : 1;
                        drop-shadow-color: self.enabled && self.hovered && !self.pressed ? #00000033 : transparent;
                        drop-shadow-offset-x: 0px;
                        drop-shadow-offset-y: self.enabled && self.hovered && !self.pressed ? 8px * root.metric-scale : 0px;
                        drop-shadow-blur: self.enabled && self.hovered && !self.pressed ? 16px * root.metric-scale : 0px;
                        animate y, transform-scale {
                            enabled: PopoverMotion.enabled;
                            duration: 120ms;
                            easing: cubic-bezier(0.2, 0, 0, 1);
                        }
                        animate background {
                            enabled: PopoverMotion.enabled;
                            duration: 150ms;
                            easing: cubic-bezier(0.2, 0, 0, 1);
                        }
                        filled: false;
                        enabled: root.action-enabled && !root.lock-busy;
                        allow-return-repeat: false;
                        accessible-text: @tr("Lock session");
                        background: !self.enabled ? transparent
                            : self.pressed ? SeelenPalette.accent.with-alpha(0.3)
                            : self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
                        clicked => { root.action-requested(PowerMenuAction.LockSession); }
                        focus-acquired => { root.reveal-lock(); }
                        lock-icon := Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height - 4px * root.metric-scale - root.text-height) / 2;
                            width: 25px * root.metric-scale;
                            height: 25px * root.metric-scale;
                            source: @image-url("../assets/icons/ionicons-5.5.4/lock-closed.svg");
                            image-fit: contain;
                            colorize: SeelenPalette.foreground;
                            accessible-role: none;
                        }
                        lock-label := Text {
                            x: 4px * root.metric-scale;
                            y: (parent.height + 25px * root.metric-scale + 4px * root.metric-scale - root.text-height) / 2;
                            width: max(0px, parent.width - 8px * root.metric-scale);
                            height: root.text-height;
                            text: @tr("Lock session");
                            font-size: root.font-size;
                            font-family: PopoverTokens.font-family;
                            font-weight: 500;
                            line-height-factor: root.text-line-height-factor;
                            color: SeelenPalette.foreground;
                            horizontal-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                }
            }
        }
    }
}
