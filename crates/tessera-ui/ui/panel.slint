import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { GeneralPreferences } from "general-preferences.slint";
import { ShortcutPreferences } from "shortcut-preferences.slint";
import { TileButton } from "tiles.slint";
import { SeelenPalette } from "palette.slint";

export { Dock, DockApp, DockWindow, DockGroup, DockStatus, DockDragVisual, DockTileAppearance, DockOrderMetrics } from "dock.slint";
export { DockWindowCommand, DockSystemCommand, DockMenuKind, DockMenuAction, DockReservedAction, DockRecycleAction, DockRecycleState } from "shell-commands.slint";
export { ContextMenuSurface, MenuEntry } from "context-menu.slint";
export { TooltipSurface } from "tooltip.slint";
export { TileBounds, FocusTokens } from "tiles.slint";
export { SeelenPalette, MaterialRoles } from "palette.slint";
export { PopoverTokens, PopoverMotion } from "popover.slint";
export { Toolbar } from "toolbar.slint";
export { Launcher, LaunchTile, LaunchRow, LauncherNavigation, LauncherView, LauncherDisplayMode, LauncherGridMetrics, LauncherDragVisual } from "launcher.slint";
export { QuickSettings, AudioRoute } from "quick-settings.slint";
export { AudioDeviceView, AudioSessionView } from "audio-devices.slint";
export { UserMenu, UserFolderKind, UserFolderRow, UserProfileAction } from "user-menu.slint";
export { CalendarMenu, CalendarMode, CalendarDayCell, CalendarWeekRow, CalendarMonthCell, CalendarMonthRow } from "calendar.slint";
export { PowerMenuSurface, PowerMenuAction } from "power-menu.slint";
export { BatteryMenu, BatteryRow } from "battery.slint";
export { NetworkMenu, NetworkRow, NetworkControlRow } from "network-menu.slint";
export { BluetoothMenu, BluetoothRadioRow, BluetoothRadioControlRow, BluetoothDeviceRow, BluetoothRadioStatus, BluetoothTransportKind } from "bluetooth.slint";
export { InputLanguageMenu, InputProfileRow } from "input-language.slint";
export { DockMediaView, MediaAction, MediaSessionChoice } from "dock-media.slint";
// Re-export the style Palette global so Rust can drive the dock strip's
// scheme from the panel's live preview without a second settings surface.
export { Palette } from "std-widgets.slint";

export struct Row {
    key: string,
    caption: string,
    minimized: bool,
}

export struct AppRow {
    key: string,
    label: string,
    pinned: bool,
}

// Readonly native collection facts, never per-member mutation capabilities.
export struct WallpaperCollectionItem {
    caption: string,
    preview: image,
    available: bool,
}

// Derived geometry lives in this component, including in conditional pages.
component ViewportTileButton inherits TileButton {
    in property <length> viewport-x;
    in property <length> viewport-y;
    in property <length> viewport-width;
    in property <length> viewport-height;
    in-out property <bool> fully-visible: self.width > 0px && self.height > 0px
        && root.viewport-width > 0px && root.viewport-height > 0px
        && self.absolute-position.x >= root.viewport-x
        && self.absolute-position.y >= root.viewport-y
        && self.absolute-position.x + self.width <= root.viewport-x + root.viewport-width
        && self.absolute-position.y + self.height <= root.viewport-y + root.viewport-height;
}

// Settings use flat translucent groups, not the shared shell's raised tiles.
component SettingsGroup inherits Rectangle {
    border-radius: 10px;
    background: SeelenPalette.reference-mode
        ? (SeelenPalette.dark ? rgba(0, 0, 0, 0.10) : rgba(0, 0, 0, 0.03))
        : SeelenPalette.surface-container;
    vertical-stretch: 0;
    max-height: self.preferred-height;
    VerticalLayout {
        padding: 12px;
        spacing: 12px;
        @children
    }
}

component SettingsRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> description;
    in property <length> controls-height: 24px;
    spacing: 12px;
    vertical-stretch: 0;
    VerticalLayout {
        horizontal-stretch: 1;
        Text {
            text: root.label;
            color: SeelenPalette.foreground;
            font-weight: 600;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if root.description != "": Text {
            text: root.description;
            color: SeelenPalette.running-indicator;
            font-size: SeelenPalette.body-font-size;
            wrap: word-wrap;
        }
    }
    HorizontalLayout {
        min-width: 150px;
        horizontal-stretch: 0;
        min-height: root.controls-height;
        max-height: root.controls-height;
        vertical-stretch: 0;
        spacing: 8px;
        alignment: end;
        @children
    }
}

component SettingsNavigation inherits TileButton {
    in property <string> label;
    in property <image> icon;
    in property <bool> collapsed;
    accessible-text: root.label;
    height: 30px;
    min-width: 0px;
    radius: 8px;
    filled: false;
    property <color> navigation-foreground: root.selected && !SeelenPalette.reference-mode
        ? SeelenPalette.on-primary : SeelenPalette.foreground;
    background: root.selected ? SeelenPalette.accent
        : root.hovered ? (SeelenPalette.reference-mode ? Palette.accent-background : SeelenPalette.hover)
        : transparent;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: root.navigation-foreground;
            accessible-role: none;
        }
        if !root.collapsed: Text {
            text: root.label;
            color: root.navigation-foreground;
            font-size: SeelenPalette.body-font-size;
            font-weight: SeelenPalette.title-font-weight;
            overflow: elide;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

export component Panel inherits Window {
    default-font-family: SeelenPalette.font-family;
    title: "Tessera " + root.version + " — alpha";
    background: SeelenPalette.surface;
    default-font-size: SeelenPalette.reference-mode ? 16px : SeelenPalette.body-font-size;
    preferred-width: 800px;
    preferred-height: 500px;
    min-width: 600px;
    min-height: 400px;

    // In/out state (the controller reads and writes these).
    in-out property <[Row]> rows;
    in-out property <[AppRow]> apps;
    in-out property <string> search;
    in-out property <int> theme-index;
    in-out property <int> source-rgb: 8168540; // #7ca45c
    in property <string> source-hex: "#7ca45c";
    in-out property <int> source-preset-index: 0;
    in-out property <string> custom-source-hex: "#7ca45c";
    in-out property <string> custom-source-notice;
    out property <bool> source-custom-input-active;
    out property <bool> source-custom-visible: root.selected-page == 1 && !SeelenPalette.reference-mode;
    changed source-hex => { root.reset-source-color-input(root.source-hex); }
    public function reset-source-color-input(value: string) {
        root.custom-source-hex = value;
        root.custom-source-notice = "";
    }
    in-out property <int> dock-edge-index;
    in-out property <bool> compact;
    in-out property <int> start-of-week-index: 0;

    in property <bool> dock-preferences-available: false;
    in-out property <int> dock-middle-click-index: 0;
    in property <bool> telemetry-available: false;
    in-out property <bool> telemetry-enabled: false;
    in property <bool> bar-visibility-available: false;
    in-out property <int> dock-auto-hide-index: 2;
    in-out property <int> toolbar-auto-hide-index: 0;
    // OS registration is immediate and deliberately separate from Save/Cancel.
    in property <bool> startup-available: false;
    in property <bool> startup-busy;
    in property <bool> startup-known;
    in property <bool> startup-registered;
    in property <bool> startup-controls-enabled;
    in property <string> startup-status: "Registration has not been read.";
    in property <string> startup-input-key;
    out property <bool> startup-general-visible: root.selected-page == 0;
    out property <bool> startup-input-active;
    out property <bool> startup-refresh-input-active;
    out property <bool> startup-control-visible;
    callback startup-requested(bool);
    callback startup-refresh-requested();
    callback startup-event-ready();
    callback startup-view-changed();
    changed startup-general-visible => { root.startup-view-changed(); }
    // Wallpaper is an immediate Windows effect, not a preference draft.
    in property <bool> wallpaper-available: false;
    in property <bool> wallpaper-busy;
    in property <bool> wallpaper-controls-enabled;
    in property <bool> wallpaper-apply-enabled;
    in property <string> wallpaper-status: "Current Windows wallpaper has not been read.";
    in property <string> wallpaper-input-key;
    in property <bool> wallpaper-monitor-selection-available: false;
    in property <[string]> wallpaper-monitors;
    in-out property <int> wallpaper-monitor-index: -1;
    in property <bool> wallpaper-preview-available: false;
    in property <image> wallpaper-preview;
    in property <string> wallpaper-preview-status: "No current image selection.";
    in property <bool> wallpaper-colors-enabled: false;
    in property <int> wallpaper-color-rgb: -1;
    in property <string> wallpaper-colors-status: "Choose a fresh image to preview its native thumbnail colors.";
    out property <bool> wallpaper-page-visible: root.selected-page == 1 && !SeelenPalette.reference-mode;
    out property <bool> wallpaper-choose-input-active;
    out property <bool> wallpaper-apply-input-active;
    out property <bool> wallpaper-colors-input-active;
    // Live geometry stays independent of busy/enabled: admitted callbacks
    // temporarily disable controls before rechecking their actual clipping.
    property <bool> wallpaper-choose-clip;
    property <bool> wallpaper-apply-clip;
    property <bool> wallpaper-colors-clip;
    out property <bool> wallpaper-choose-control-visible:
        root.wallpaper-page-visible && root.wallpaper-available && root.wallpaper-choose-clip;
    out property <bool> wallpaper-apply-control-visible:
        root.wallpaper-page-visible && root.wallpaper-available && root.wallpaper-apply-clip;
    out property <bool> wallpaper-colors-control-visible: root.wallpaper-page-visible
        && root.wallpaper-available && root.wallpaper-monitor-selection-available
        && root.wallpaper-colors-clip;
    callback wallpaper-choose-requested();
    callback wallpaper-apply-requested();
    callback wallpaper-monitor-changed(int);
    callback wallpaper-colors-requested();
    callback wallpaper-event-ready();
    callback wallpaper-view-changed();
    changed wallpaper-page-visible => { root.wallpaper-view-changed(); }
    // Explicit global slideshow command. Proposed values are not native observations.
    in property <bool> wallpaper-collection-controls-enabled;
    in property <bool> wallpaper-collection-apply-enabled;
    in property <bool> wallpaper-collection-command-available: false;
    in property <[WallpaperCollectionItem]> wallpaper-collection-items;
    in-out property <int> wallpaper-collection-interval-index: -1;
    in-out property <bool> wallpaper-collection-shuffle: false;
    in property <string> wallpaper-collection-status: "No current collection. Native slideshow policy has not been read.";
    out property <bool> wallpaper-collection-choose-input-active;
    out property <bool> wallpaper-collection-apply-input-active;
    property <bool> wallpaper-collection-choose-clip;
    property <bool> wallpaper-collection-apply-clip;
    out property <bool> wallpaper-collection-choose-control-visible:
        root.wallpaper-page-visible && root.wallpaper-available
        && root.wallpaper-collection-choose-clip;
    out property <bool> wallpaper-collection-apply-control-visible:
        root.wallpaper-page-visible && root.wallpaper-available
        && root.wallpaper-collection-apply-clip;
    callback wallpaper-collection-choose-requested();
    callback wallpaper-collection-apply-requested();
    callback wallpaper-collection-interval-changed(int);
    callback wallpaper-collection-shuffle-changed();
    // Global Windows policy: explicit observation and immediate effect, never a saved draft.
    in property <bool> wallpaper-position-available: false;
    in property <bool> wallpaper-position-busy;
    in property <bool> wallpaper-position-read-enabled;
    in property <bool> wallpaper-position-apply-enabled;
    in property <bool> wallpaper-position-desired-enabled;
    in property <bool> wallpaper-position-command-available: false;
    in-out property <int> wallpaper-position-desired-index: -1;
    in property <string> wallpaper-position-observed: "Native current position has not been read.";
    in property <string> wallpaper-position-status: "Read current explicitly; no default is assumed.";
    in property <string> wallpaper-position-input-key;
    out property <bool> wallpaper-position-read-input-active;
    out property <bool> wallpaper-position-apply-input-active;
    property <bool> wallpaper-position-read-clip;
    property <bool> wallpaper-position-apply-clip;
    out property <bool> wallpaper-position-read-control-visible:
        root.wallpaper-page-visible && root.wallpaper-position-available
        && root.wallpaper-position-read-clip;
    out property <bool> wallpaper-position-apply-control-visible:
        root.wallpaper-page-visible && root.wallpaper-position-available
        && root.wallpaper-position-apply-clip;
    callback wallpaper-position-read-requested();
    callback wallpaper-position-apply-requested();
    callback wallpaper-position-desired-changed(int);
    callback wallpaper-position-event-ready();
    // Inputs from the controller.
    in property <string> summary: "No observation yet";
    in property <string> status: "Ready to observe";
    in-out property <bool> status-is-feedback: false;
    in property <bool> refreshing;
    in property <bool> has-snapshot;
    // True while the retained data must not be activated: refreshing or
    // after a failed refresh, until the next success confirms the desktop.
    in property <bool> stale;
    in property <string> startup-notice;
    in property <string> version;
    in property <bool> shortcuts-controls-enabled: true;
    in property <bool> shortcuts-enabled: true;
    in property <string> shortcuts-settings-label: "Win + K";
    in property <bool> shortcuts-capturing;
    in property <bool> shortcuts-dirty;
    in property <bool> shortcuts-applying;
    in property <string> shortcuts-launcher-status: "Not applied";
    in property <string> shortcuts-settings-status: "Not applied";
    in property <string> shortcuts-message;

    callback refresh-requested();
    callback filter-requested();
    changed search => { root.filter-requested(); }
    callback activate-requested(string /* key */);
    callback launch-requested(string /* key */);
    callback pin-toggle-requested(string /* key */, bool /* pinned */);
    callback system-action-requested(int /* action */);
    callback save-preferences-requested();
    callback cancel-preferences-requested();
    callback shortcuts-enabled-edited(bool);
    callback shortcuts-capture-requested();
    callback shortcuts-capture-cancelled();
    callback shortcuts-reset-requested();
    callback shortcuts-capture-pressed(KeyEvent) -> bool;
    callback shortcuts-capture-released(KeyEvent) -> bool;
    callback shortcuts-event-ready();
    callback shortcut-trigger-ready();

    public function focus-shortcut-capture() {
        root.select-page(3);
        shortcut-preferences.focus-capture();
    }
    public function cancel-shortcut-input() { shortcut-preferences.cancel-input(); }
    // A shared live appearance preview updates every surface without Save.
    callback appearance-changed();
    callback source-preset-requested(int);
    callback source-custom-requested(string) -> bool;
    // The one-shot dock-mode readiness pulse: `run` wires this to the
    // supervisor heartbeat armer on the UI thread (the heartbeat is not
    // Send, so the Send observation route reaches it only through here).
    callback readiness-pulse();
    callback observation-result-ready();
    callback motion-policy-changed(bool /* enabled */);
    // Weak component relays keep independent Power actors out of root cycles.
    callback power-popup-opened();
    callback power-action-result(bool, string);
    callback power-command-event-ready();
    callback power-command-busy-changed(bool);
    callback user-logout-event-ready();
    callback power-display-event-ready();
    callback visibility-event-ready();

    // Live preview: only explicit Save persists through the host. The
    // two-way binding keeps the user's choice while propagating to Palette.
    property <ColorScheme> color-scheme <=> Palette.color-scheme;
    property <ColorScheme> theme-derived: root.theme-index == 1 ? ColorScheme.light :
        root.theme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    changed theme-derived => {
        color-scheme = theme-derived;
        root.appearance-changed();
    }
    changed compact => { root.appearance-changed(); }
    changed dock-edge-index => { root.appearance-changed(); }
    changed source-rgb => { root.appearance-changed(); }

    property <length> row-height: root.compact ? 24px : 32px;
    property <int> selected-page: 0;
    property <bool> sidebar-collapsed;
    property <length> sidebar-width: root.sidebar-collapsed ? 44px : 192px;
    property <color> divider: SeelenPalette.reference-mode
        ? (SeelenPalette.dark ? oklch(0.36, 0, 0) : oklch(0.81, 0, 0))
        : SeelenPalette.outline-variant;
    property <color> shell-overlay: SeelenPalette.reference-mode
        ? (SeelenPalette.dark ? #0000001a : #00000008)
        : SeelenPalette.surface-container-low;
    property <string> page-title: ["General", "Appearance", "Dock", "Shortcuts", "Desktop & recovery"][root.selected-page];

    // Navigation is presentation only: retain root drafts and cancel the scoped
    // key capture synchronously before its controls are hidden.
    function select-page(page: int) {
        if page >= 0 && page < 5 && page != root.selected-page {
            if root.selected-page == 3 { root.cancel-shortcut-input(); }
            root.selected-page = page;
            page-scroll.content-y = 0px;
            page-scroll.content-x = 0px;
        }
    }

    // Retain the neutral source gradients only in its explicit reference skin.
    // Material uses the shared opaque surface/container roles instead.
    Rectangle {
        visible: SeelenPalette.reference-mode;
        background: @linear-gradient(336deg,
            (SeelenPalette.dark ? oklch(0.27, 0.056, 230) : oklch(0.90, 0.053, 230)) 0%,
            rgba(0, 255, 0, 0) 70%);
    }
    Rectangle {
        visible: SeelenPalette.reference-mode;
        background: @linear-gradient(127deg,
            (SeelenPalette.dark ? oklch(0.27, 0.111, 260) : oklch(0.90, 0.042, 260)) 0%,
            rgba(0, 0, 255, 0) 70%);
    }
    Rectangle {
        visible: SeelenPalette.reference-mode;
        background: @linear-gradient(217deg,
            (SeelenPalette.dark ? oklch(0.27, 0.096, 30) : oklch(0.90, 0.054, 30)) 0%,
            rgba(255, 0, 0, 0) 70%);
    }

    sidebar := Rectangle {
        x: 0px;
        y: 0px;
        width: root.sidebar-width;
        height: parent.height;
        background: root.shell-overlay;
        clip: true;
        VerticalLayout {
            spacing: 0px;
            TileButton {
                height: 50px;
                radius: 0px;
                filled: false;
                accessible-text: root.sidebar-collapsed ? "Expand settings sidebar" : "Collapse settings sidebar";
                clicked => { root.sidebar-collapsed = !root.sidebar-collapsed; }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: "T";
                        width: 28px;
                        color: SeelenPalette.foreground;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    if !root.sidebar-collapsed: Text {
                        text: "Tessera";
                        color: SeelenPalette.foreground;
                        font-size: SeelenPalette.title-font-size;
                        font-weight: SeelenPalette.title-font-weight;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }
                    if !root.sidebar-collapsed: Text {
                        text: "‹";
                        color: SeelenPalette.foreground;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: root.divider;
                }
            }
            ScrollView {
                min-width: 0px;
                vertical-stretch: 1;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    padding-top: 12px;
                    padding-bottom: 12px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    SettingsNavigation {
                        label: "General";
                        icon: @image-url("../assets/icons/tabler-icons-6d128ed/settings.svg");
                        collapsed: root.sidebar-collapsed;
                        selected: root.selected-page == 0;
                        clicked => { root.select-page(0); }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    VerticalLayout {
                        spacing: 8px;
                        SettingsNavigation {
                            label: "Appearance";
                            icon: @image-url("../assets/icons/tabler-icons-6d128ed/palette.svg");
                            collapsed: root.sidebar-collapsed;
                            selected: root.selected-page == 1;
                            clicked => { root.select-page(1); }
                        }
                        SettingsNavigation {
                            label: "Dock";
                            icon: @image-url("../assets/icons/tabler-icons-6d128ed/layout-bottombar.svg");
                            collapsed: root.sidebar-collapsed;
                            selected: root.selected-page == 2;
                            clicked => { root.select-page(2); }
                        }
                    }
                    Rectangle { height: 1px; background: root.divider; }
                    VerticalLayout {
                        spacing: 8px;
                        SettingsNavigation {
                            label: "Shortcuts";
                            icon: @image-url("../assets/icons/tabler-icons-6d128ed/keyboard.svg");
                            collapsed: root.sidebar-collapsed;
                            selected: root.selected-page == 3;
                            clicked => { root.select-page(3); }
                        }
                        SettingsNavigation {
                            label: "Desktop & recovery";
                            icon: @image-url("../assets/icons/tabler-icons-6d128ed/tool.svg");
                            collapsed: root.sidebar-collapsed;
                            selected: root.selected-page == 4;
                            clicked => { root.select-page(4); }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: root.divider; }
            if !root.sidebar-collapsed: Text {
                text: "Tessera " + root.version + " · alpha";
                color: SeelenPalette.running-indicator;
                font-size: SeelenPalette.body-font-size;
                height: self.preferred-height + 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    Rectangle {
        x: root.sidebar-width;
        y: 0px;
        width: parent.width - self.x;
        height: parent.height;
        VerticalLayout {
            spacing: 0px;
            header := Rectangle {
                height: 50px;
                background: root.shell-overlay;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 12px;
                    Text {
                        text: root.page-title;
                        color: SeelenPalette.foreground;
                        font-size: SeelenPalette.title-font-size;
                        font-weight: SeelenPalette.title-font-weight;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        horizontal-stretch: 0;
                        min-width: header-actions.min-width;
                        preferred-width: header-actions.preferred-width;
                        height: header.height;
                        header-actions := HorizontalLayout {
                            y: (parent.height - self.height) / 2;
                            height: 24px;
                            spacing: 4px;
                            Button {
                                text: "Cancel";
                                accessible-label: "Cancel changes";
                                min-width: 60px;
                                min-height: 24px;
                                max-height: 24px;
                                clicked => { root.cancel-preferences-requested(); }
                            }
                            Button {
                                text: "Save";
                                accessible-label: "Save preferences";
                                min-width: 60px;
                                min-height: 24px;
                                max-height: 24px;
                                clicked => { root.save-preferences-requested(); }
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: root.divider;
                }
            }
            // Host feedback is global, including failed Save and startup recovery.
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 8px;
                padding-bottom: 4px;
                spacing: 4px;
                Text {
                    text: root.status;
                    color: SeelenPalette.foreground;
                    font-size: SeelenPalette.body-font-size;
                    wrap: word-wrap;
                }
                if root.startup-notice != "": Text {
                    text: root.startup-notice;
                    color: SeelenPalette.foreground;
                    font-size: SeelenPalette.body-font-size;
                    wrap: word-wrap;
                }
            }
            page-scroll := ScrollView {
                vertical-stretch: 1;
                content-width: self.visible-width;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                VerticalLayout {
                    padding: 12px;
                    spacing: 0px;
                    alignment: start;
                    if root.selected-page == 0: general-group := SettingsGroup {
                        GeneralPreferences {
                            start-of-week-index <=> root.start-of-week-index;
                            compact: root.compact;
                        }
                        if root.bar-visibility-available: SettingsRow {
                            label: "Toolbar auto-hide";
                            description: "Apply after Save; fullscreen protection remains; unavailable native hints keep bars visible.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Toolbar auto-hide after Save";
                                model: ["Never", "Always", "On overlap"];
                                current-index <=> root.toolbar-auto-hide-index;
                            }
                        }
                        if root.telemetry-available: SettingsRow {
                            label: "CPU and RAM";
                            description: "Sample once per second while the Toolbar is shown. Enable after Save.";
                            CheckBox {
                                text: "";
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Show native CPU and RAM statistics after Save";
                                checked <=> root.telemetry-enabled;
                            }
                        }
                        if root.startup-available: SettingsRow {
                            label: "Start Tessera at sign-in";
                            description: "Changes the current user's startup registration immediately, not the sign-in shell. Save and Cancel do not affect it. Windows may delay or disable startup.\n" + root.startup-status;
                            TileButton {
                                min-width: 68px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.startup-input-key;
                                enabled: root.startup-controls-enabled && !root.startup-busy;
                                accessible-text: root.startup-registered
                                    ? "Disable current-user startup registration"
                                    : "Enable current-user startup registration";
                                accessible-description: root.startup-status;
                                clicked => {
                                    let origin = self.absolute-position;
                                    let viewport = page-scroll.absolute-position;
                                    root.startup-control-visible = self.width > 0px && self.height > 0px
                                        && origin.x >= viewport.x && origin.y >= viewport.y
                                        && origin.x + self.width <= viewport.x + page-scroll.visible-width
                                        && origin.y + self.height <= viewport.y + page-scroll.visible-height;
                                    root.startup-input-active = root.startup-known
                                        && root.startup-controls-enabled && !root.startup-busy
                                        && root.startup-control-visible;
                                    if root.startup-input-active {
                                        root.startup-requested(!root.startup-registered);
                                    }
                                    root.startup-input-active = false;
                                }
                                Text {
                                    text: root.startup-known ? (root.startup-registered ? "Disable" : "Enable") : "Unknown";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            TileButton {
                                min-width: 68px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.startup-input-key;
                                enabled: !root.startup-busy;
                                accessible-text: "Refresh startup registration";
                                clicked => {
                                    let origin = self.absolute-position;
                                    let viewport = page-scroll.absolute-position;
                                    root.startup-refresh-input-active = self.width > 0px && self.height > 0px
                                        && origin.x >= viewport.x && origin.y >= viewport.y
                                        && origin.x + self.width <= viewport.x + page-scroll.visible-width
                                        && origin.y + self.height <= viewport.y + page-scroll.visible-height;
                                    if root.startup-refresh-input-active { root.startup-refresh-requested(); }
                                    root.startup-refresh-input-active = false;
                                }
                                Text {
                                    text: "Refresh";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                    }
                    if root.selected-page == 1: SettingsGroup {
                        SettingsRow {
                            label: "Theme";
                            description: "Preview immediately. Save to keep this appearance.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Appearance theme";
                                model: ["System", "Light", "Dark"];
                                current-index <=> root.theme-index;
                            }
                        }
                        SettingsRow {
                            label: "Color source";
                            description: "Current source: " + root.source-hex + ". Preview now; Save to keep.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Appearance color source";
                                model: ["Green", "Amber", "Blue", "Coral", "Pink"];
                                current-index <=> root.source-preset-index;
                                selected(value) => { root.source-preset-requested(self.current-index); }
                            }
                        }
                        SettingsRow {
                            label: "Compact";
                            description: "Use denser desktop observation rows.";
                            CheckBox {
                                text: "";
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Compact";
                                checked <=> root.compact;
                            }
                        }
                        if !SeelenPalette.reference-mode: SettingsRow {
                            label: "Custom color";
                            description: root.custom-source-notice == ""
                                ? "Enter #RRGGBB, Preview to apply, then Save to keep."
                                : root.custom-source-notice;
                            LineEdit {
                                width: 104px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Custom Material source color in #RRGGBB format";
                                text <=> root.custom-source-hex;
                            }
                            TileButton {
                                min-width: 68px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.custom-source-hex;
                                accessible-text: "Preview custom Material source color";
                                clicked => {
                                    let origin = self.absolute-position;
                                    let viewport = page-scroll.absolute-position;
                                    root.source-custom-input-active = self.width > 0px && self.height > 0px
                                        && origin.x >= viewport.x && origin.y >= viewport.y
                                        && origin.x + self.width <= viewport.x + page-scroll.visible-width
                                        && origin.y + self.height <= viewport.y + page-scroll.visible-height;
                                    if root.source-custom-input-active {
                                        let applied = root.source-custom-requested(root.custom-source-hex);
                                        root.custom-source-notice = applied ? ""
                                            : "Preview was not applied. Enter an exact #RRGGBB color in this Settings view.";
                                    }
                                    root.source-custom-input-active = false;
                                }
                                Text {
                                    text: "Preview";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode: SettingsRow {
                            label: "Windows wallpaper";
                            description: "Apply changes Windows immediately on the chosen captured display or all captured displays. Save and Cancel do not apply or undo it.\n" + root.wallpaper-status;
                            wallpaper-choose := ViewportTileButton {
                                fully-visible <=> root.wallpaper-choose-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 100px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-input-key;
                                enabled: root.wallpaper-controls-enabled && !root.wallpaper-busy;
                                accessible-text: "Choose a Windows wallpaper image";
                                accessible-description: "Open the native Windows file picker. " + root.wallpaper-status;
                                clicked => {
                                    root.wallpaper-choose-input-active = root.wallpaper-choose-control-visible
                                        && root.wallpaper-controls-enabled && !root.wallpaper-busy;
                                    if root.wallpaper-choose-input-active { root.wallpaper-choose-requested(); }
                                    root.wallpaper-choose-input-active = false;
                                }
                                Text {
                                    text: "Choose image";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            wallpaper-apply := ViewportTileButton {
                                fully-visible <=> root.wallpaper-apply-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 68px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-input-key;
                                enabled: root.wallpaper-controls-enabled && root.wallpaper-apply-enabled
                                    && !root.wallpaper-busy;
                                accessible-text: "Apply selected Windows wallpaper immediately";
                                accessible-description: root.wallpaper-status;
                                clicked => {
                                    root.wallpaper-apply-input-active = root.wallpaper-apply-control-visible
                                        && root.wallpaper-controls-enabled && root.wallpaper-apply-enabled
                                        && !root.wallpaper-busy;
                                    if root.wallpaper-apply-input-active { root.wallpaper-apply-requested(); }
                                    root.wallpaper-apply-input-active = false;
                                }
                                Text {
                                    text: "Apply";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode
                            && root.wallpaper-monitor-selection-available: SettingsRow {
                            label: "Wallpaper displays";
                            description: "Actual Windows displays captured when choosing this image. This scope is not saved with preferences.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                enabled: root.wallpaper-controls-enabled && !root.wallpaper-busy;
                                accessible-label: "Captured Windows wallpaper display scope";
                                model: root.wallpaper-monitors;
                                current-index <=> root.wallpaper-monitor-index;
                                selected(value) => { root.wallpaper-monitor-changed(self.current-index); }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode
                            && root.wallpaper-monitor-selection-available: SettingsRow {
                            label: "Selected image preview";
                            description: root.wallpaper-preview-status;
                            controls-height: root.wallpaper-preview-available ? 96px : 24px;
                            if root.wallpaper-preview-available: Image {
                                width: 128px;
                                height: 96px;
                                horizontal-stretch: 0;
                                source: root.wallpaper-preview;
                                image-fit: contain;
                                accessible-label: "Selected native Windows Shell thumbnail, not desktop-rendered wallpaper";
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode
                            && root.wallpaper-monitor-selection-available: SettingsRow {
                            label: "Image colors";
                            description: root.wallpaper-colors-status;
                            wallpaper-colors := ViewportTileButton {
                                fully-visible <=> root.wallpaper-colors-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 150px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-input-key;
                                enabled: root.wallpaper-controls-enabled && root.wallpaper-colors-enabled
                                    && !root.wallpaper-busy;
                                accessible-text: "Preview selected image colors in Material only";
                                accessible-description: root.wallpaper-colors-status;
                                clicked => {
                                    root.wallpaper-colors-input-active = root.wallpaper-colors-control-visible
                                        && root.wallpaper-controls-enabled && root.wallpaper-colors-enabled
                                        && !root.wallpaper-busy;
                                    if root.wallpaper-colors-input-active { root.wallpaper-colors-requested(); }
                                    root.wallpaper-colors-input-active = false;
                                }
                                Text {
                                    text: "Preview image colors";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        if root.wallpaper-position-available && !SeelenPalette.reference-mode: SettingsRow {
                            label: "Global Windows position";
                            description: "Apply changes the global wallpaper position immediately on the system's monitors, including future monitors. It does not use the image's captured display selector. Save and Cancel do not apply or undo it.\n"
                                + root.wallpaper-position-observed + "\n" + root.wallpaper-position-status;
                            ViewportTileButton {
                                fully-visible <=> root.wallpaper-position-read-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 100px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-position-input-key;
                                enabled: root.wallpaper-position-available
                                    && root.wallpaper-position-read-enabled && !root.wallpaper-position-busy;
                                accessible-text: "Read current global Windows wallpaper position";
                                accessible-description: root.wallpaper-position-status;
                                clicked => {
                                    root.wallpaper-position-read-input-active = root.wallpaper-position-read-control-visible
                                        && root.wallpaper-position-available
                                        && root.wallpaper-position-read-enabled && !root.wallpaper-position-busy;
                                    if root.wallpaper-position-read-input-active { root.wallpaper-position-read-requested(); }
                                    root.wallpaper-position-read-input-active = false;
                                }
                                Text {
                                    text: "Read current";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            ViewportTileButton {
                                fully-visible <=> root.wallpaper-position-apply-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 104px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-position-input-key;
                                enabled: root.wallpaper-position-available
                                    && root.wallpaper-position-apply-enabled && !root.wallpaper-position-busy;
                                accessible-text: "Apply proposed Windows wallpaper position globally now";
                                accessible-description: "Immediate global Windows effect, independent of Save, Cancel, and the image display selector. " + root.wallpaper-position-status;
                                clicked => {
                                    root.wallpaper-position-apply-input-active = root.wallpaper-position-apply-control-visible
                                        && root.wallpaper-position-available
                                        && root.wallpaper-position-apply-enabled && !root.wallpaper-position-busy;
                                    if root.wallpaper-position-apply-input-active { root.wallpaper-position-apply-requested(); }
                                    root.wallpaper-position-apply-input-active = false;
                                }
                                Text {
                                    text: "Apply globally";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        if !SeelenPalette.reference-mode && root.wallpaper-position-command-available: SettingsRow {
                            label: "Proposed global position";
                            description: "This is only the proposed command. The separate native observation above is not changed until Apply and fresh native readback.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                enabled: root.wallpaper-position-desired-enabled && !root.wallpaper-position-busy;
                                accessible-label: "Proposed global Windows wallpaper position";
                                model: ["Center", "Tile", "Stretch", "Fit", "Fill", "Span"];
                                current-index <=> root.wallpaper-position-desired-index;
                                selected(value) => { root.wallpaper-position-desired-changed(self.current-index); }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode: SettingsRow {
                            label: "Global Windows slideshow";
                            description: "Start enables the desktop background and changes Windows slideshow policy globally for system monitors, including future monitors—not the image's captured display subset. Windows owns scheduling and persistence. Save and Cancel do not apply or undo it.\n"
                                + root.wallpaper-collection-status;
                            ViewportTileButton {
                                fully-visible <=> root.wallpaper-collection-choose-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 132px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-input-key;
                                enabled: root.wallpaper-collection-controls-enabled && !root.wallpaper-busy;
                                accessible-text: "Choose a native Windows wallpaper collection";
                                accessible-description: "Select 2 to 32 actual image files in the same folder. This retires the previous file selection but does not start a slideshow.";
                                clicked => {
                                    root.wallpaper-collection-choose-input-active =
                                        root.wallpaper-collection-choose-control-visible
                                        && root.wallpaper-collection-controls-enabled && !root.wallpaper-busy;
                                    if root.wallpaper-collection-choose-input-active { root.wallpaper-collection-choose-requested(); }
                                    root.wallpaper-collection-choose-input-active = false;
                                }
                                Text {
                                    text: "Choose collection";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                            ViewportTileButton {
                                fully-visible <=> root.wallpaper-collection-apply-clip;
                                viewport-x: page-scroll.absolute-position.x;
                                viewport-y: page-scroll.absolute-position.y;
                                viewport-width: page-scroll.visible-width;
                                viewport-height: page-scroll.visible-height;
                                min-width: 114px;
                                radius: 6px;
                                allow-return-repeat: false;
                                activation-key: root.wallpaper-input-key;
                                enabled: root.wallpaper-collection-controls-enabled
                                    && root.wallpaper-collection-apply-enabled && !root.wallpaper-busy;
                                accessible-text: "Start Windows slideshow globally now";
                                accessible-description: "Enables the desktop background and sets the selected collection and proposed options globally, including future monitors. The two SDK writes may partially succeed. " + root.wallpaper-collection-status;
                                clicked => {
                                    root.wallpaper-collection-apply-input-active =
                                        root.wallpaper-collection-apply-control-visible
                                        && root.wallpaper-collection-controls-enabled
                                        && root.wallpaper-collection-apply-enabled && !root.wallpaper-busy;
                                    if root.wallpaper-collection-apply-input-active { root.wallpaper-collection-apply-requested(); }
                                    root.wallpaper-collection-apply-input-active = false;
                                }
                                Text {
                                    text: "Start slideshow";
                                    color: SeelenPalette.foreground;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    accessible-role: none;
                                }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode
                            && root.wallpaper-collection-command-available: SettingsRow {
                            label: "Proposed slideshow options";
                            description: "A new command only, not the current Windows interval or shuffle state. Editing these proposals has no SDK effect. Start submits them after the collection write.";
                            ComboBox {
                                width: 120px;
                                min-height: 24px;
                                max-height: 24px;
                                enabled: root.wallpaper-collection-apply-enabled && !root.wallpaper-busy;
                                accessible-label: "Proposed Windows slideshow interval";
                                model: ["1 minute", "10 minutes", "30 minutes", "1 hour", "6 hours", "1 day"];
                                current-index <=> root.wallpaper-collection-interval-index;
                                selected(value) => { root.wallpaper-collection-interval-changed(self.current-index); }
                            }
                            CheckBox {
                                enabled: root.wallpaper-collection-apply-enabled && !root.wallpaper-busy;
                                text: "Shuffle";
                                checked <=> root.wallpaper-collection-shuffle;
                                toggled => { root.wallpaper-collection-shuffle-changed(); }
                            }
                        }
                        if root.wallpaper-available && !SeelenPalette.reference-mode
                            && root.wallpaper-collection-command-available: VerticalLayout {
                            spacing: 8px;
                            for item in root.wallpaper-collection-items: SettingsRow {
                                label: item.caption;
                                description: item.available
                                    ? "Native Shell thumbnail of this selected file; not desktop-rendered pixels."
                                    : "Native thumbnail unavailable for this selected file.";
                                controls-height: item.available ? 96px : 24px;
                                if item.available: Image {
                                    width: 128px;
                                    height: 96px;
                                    horizontal-stretch: 0;
                                    source: item.preview;
                                    image-fit: contain;
                                    accessible-label: item.caption + " — native Windows Shell thumbnail";
                                }
                            }
                        }
                    }
                    if root.selected-page == 2: SettingsGroup {
                        SettingsRow {
                            label: "Dock edge";
                            description: "Preview the dock position. Save to keep it.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Dock edge (saved with preferences)";
                                model: ["Bottom", "Top", "Left", "Right"];
                                current-index <=> root.dock-edge-index;
                            }
                        }
                        if root.bar-visibility-available: SettingsRow {
                            label: "Dock auto-hide";
                            description: "Apply after Save; fullscreen protection remains; unavailable native hints keep bars visible.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Dock auto-hide after Save";
                                model: ["Never", "Always", "On overlap"];
                                current-index <=> root.dock-auto-hide-index;
                            }
                        }
                        if root.dock-preferences-available: SettingsRow {
                            label: "Middle click";
                            description: "Apply after Save. Window commands are requests, not guaranteed completion.";
                            ComboBox {
                                width: 200px;
                                min-height: 24px;
                                max-height: 24px;
                                accessible-label: "Dock middle-click action after Save";
                                model: ["New instance", "Minimize windows", "Close windows"];
                                current-index <=> root.dock-middle-click-index;
                            }
                        }
                    }
                    // Keep the focus/input object stable; hidden controls cannot
                    // enter Tab navigation or continue a captured gesture.
                    SettingsGroup {
                        visible: root.selected-page == 3;
                        min-height: root.selected-page == 3 ? shortcut-preferences.preferred-height + 24px : 0px;
                        max-height: self.min-height;
                        shortcut-preferences := ShortcutPreferences {
                            page-active: root.selected-page == 3;
                            compact: root.compact;
                            controls-enabled: root.shortcuts-controls-enabled;
                            draft-enabled: root.shortcuts-enabled;
                            settings-label: root.shortcuts-settings-label;
                            capturing: root.shortcuts-capturing;
                            dirty: root.shortcuts-dirty;
                            applying: root.shortcuts-applying;
                            launcher-status: root.shortcuts-launcher-status;
                            settings-status: root.shortcuts-settings-status;
                            message: root.shortcuts-message;
                            enabled-edited(enabled) => { root.shortcuts-enabled-edited(enabled); }
                            capture-requested => { root.shortcuts-capture-requested(); }
                            capture-cancelled => { root.shortcuts-capture-cancelled(); }
                            settings-reset-requested => { root.shortcuts-reset-requested(); }
                            capture-pressed(event) => { return root.shortcuts-capture-pressed(event); }
                            capture-released(event) => { return root.shortcuts-capture-released(event); }
                        }
                    }
                    if root.selected-page == 4: SettingsGroup {
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                accessible-label: "Search window titles";
                                placeholder-text: "Search windows and applications";
                                text <=> root.search;
                            }
                            Button {
                                text: "Refresh";
                                enabled: !root.refreshing;
                                clicked => { root.refresh-requested(); }
                            }
                        }
                        Text { text: root.summary; color: SeelenPalette.foreground; wrap: word-wrap; }
                        if root.stale && root.has-snapshot: Text {
                            text: "Last observation is stale. Refresh before switching windows.";
                            color: SeelenPalette.foreground;
                            wrap: word-wrap;
                        }
                        for row in root.rows: Button {
                            text: row.caption;
                            height: root.row-height;
                            horizontal-stretch: 1;
                            enabled: !root.refreshing && !root.stale && root.has-snapshot;
                            clicked => { root.activate-requested(row.key); }
                        }
                        for app in root.apps: HorizontalLayout {
                            height: root.row-height;
                            spacing: 8px;
                            Button {
                                text: app.label;
                                horizontal-stretch: 1;
                                enabled: !root.refreshing && !root.stale;
                                clicked => { root.launch-requested(app.key); }
                            }
                            Button {
                                text: app.pinned ? "Unpin" : "Pin";
                                accessible-label: (app.pinned ? "Unpin " : "Pin ") + app.label;
                                clicked => { root.pin-toggle-requested(app.key, app.pinned); }
                            }
                        }
                    }
                    if root.selected-page == 4: Rectangle { height: 12px; }
                    if root.selected-page == 4: SettingsGroup {
                        SettingsRow {
                            label: "System tools";
                            Button {
                                text: "File Explorer";
                                min-height: 24px;
                                max-height: 24px;
                                clicked => { root.system-action-requested(0); }
                            }
                            Button {
                                text: "Task Manager";
                                min-height: 24px;
                                max-height: 24px;
                                clicked => { root.system-action-requested(1); }
                            }
                        }
                        Text {
                            text: "Restore Windows Explorer (session + future logins)";
                            color: SeelenPalette.foreground;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Explorer is unchanged unless you press the restore button. Restoring affects this session and future logins.";
                            color: SeelenPalette.running-indicator;
                            font-size: SeelenPalette.body-font-size;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "Restore Windows Explorer";
                            accessible-label: "Restore Windows Explorer (session + future logins)";
                            clicked => { root.system-action-requested(2); }
                        }
                    }
                }
            }
            Text {
                text: "Unsigned test alpha · Windows activate only on explicit input.";
                color: SeelenPalette.running-indicator;
                font-size: SeelenPalette.body-font-size;
                wrap: word-wrap;
                height: self.preferred-height + 16px;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}
