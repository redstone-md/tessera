import { SeelenPalette } from "palette.slint";

// One Seelen-style clickable tile (dock items, launcher tiles, toolbar
// entries): a rounded rectangle with hover/pressed/focus states and a
// focusable keyboard handler (Space/Return activate) — the stock
// StateLayer pattern from the toolkit's own widgets.
//
// `clicked` fires only when enabled; disabled tiles dim and reject input.
// `accessible-role`/label make every tile a real button for the platform's
// accessibility tree.
export struct TileBounds { origin: Point, width: length, height: length }

// External outlines need the same reserved space in clipped viewports.
export global FocusTokens {
    in-out property <length> outline-width: 2px;
    in-out property <length> outline-offset: 2px;
    out property <length> outer-margin: self.outline-width + self.outline-offset;
}

export component TileButton inherits Rectangle {
    in property <string> accessible-text;
    in property <string> tooltip-text;
    in property <bool> enabled: true;
    out property <bool> hovered: touch.has-hover;
    out property <bool> pressed: root.enabled && touch.pressed;
    out property <bool> focus-visible: root.keyboard-focus && keyboard.has-focus && root.enabled;
    in property <length> radius;
    in property <bool> show-focus-ring: true;
    property <bool> keyboard-focus;
    /// false renders no idle background (transparent until hover/press).
    in property <bool> filled: true;
    public function focus-for-keyboard() {
        if root.enabled {
            keyboard.focus();
            root.keyboard-focus = true;
        }
    }
    callback clicked;
    callback middle-clicked;
    callback context-requested(Point);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point); // delay and source tile origin
    function dismiss-tooltip(delayed: bool) {
        root.tooltip-dismissed(delayed, root.absolute-position);
    }
    function update-tooltip() {
        if root.enabled && root.hovered && root.tooltip-text != "" {
            root.tooltip-requested(root.tooltip-text, {
                origin: root.absolute-position,
                width: root.width,
                height: root.height
            });
        } else {
            root.dismiss-tooltip(false);
        }
    }
    function activate() {
        root.dismiss-tooltip(false);
        root.clicked();
    }
    changed hovered => {
        if root.hovered {
            root.update-tooltip();
        } else if root.tooltip-text != "" {
            root.dismiss-tooltip(true);
        }
    }
    changed tooltip-text => { if root.hovered { root.update-tooltip(); } }
    property <bool> right-armed;
    property <bool> middle-armed;
    changed enabled => {
        if !root.enabled {
            root.middle-armed = false;
            root.right-armed = false;
            root.dismiss-tooltip(false);
            root.keyboard-focus = false;
        }
    }

    border-radius: root.radius;
    background: !root.enabled ? (root.filled ? SeelenPalette.tile : transparent) :
        touch.pressed ? SeelenPalette.pressed :
        touch.has-hover ? SeelenPalette.hover :
        root.filled ? SeelenPalette.tile : transparent;
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.accessible-text;
    accessible-action-default => { if root.enabled { root.activate(); } }


    keyboard := FocusScope {
        // Zero-size: must not react on clicks (only key events); the stock
        // StateLayer pattern from the toolkit's own widgets.
        width: 0px;
        enabled: root.enabled;
        focus-gained(reason) => {
            // Window/popup reactivation preserves the existing modality.
            if reason == FocusReason.tab-navigation || reason == FocusReason.programmatic {
                root.keyboard-focus = true;
            } else if reason == FocusReason.pointer-click {
                root.keyboard-focus = false;
            }
        }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Space || event.text == Key.Return) {
                root.keyboard-focus = true;
                root.activate();
                return accept;
            }
            if root.enabled && (event.text == Key.Menu
                || (event.text == Key.F10 && event.modifiers.shift)) {
                root.dismiss-tooltip(false);
                root.keyboard-focus = true;
                root.context-requested({
                    x: root.absolute-position.x + root.width / 2,
                    y: root.absolute-position.y + root.height / 2
                });
                return accept;
            }
            return reject;
        }
    }
    forward-focus: keyboard;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.activate(); }
        forward-focus: keyboard;
        scroll-event(event) => {
            root.dismiss-tooltip(false);
            return reject; // preserve the parent ScrollView's real scrolling
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down || event.kind == PointerEventKind.cancel {
                root.dismiss-tooltip(false);
            }
            if event.kind == PointerEventKind.down {
                // forward-focus redirects focus requests, not TouchArea
                // clicks. This is item focus, not a host foreground request.
                keyboard.focus();
                root.keyboard-focus = false;
            }
            if event.kind == PointerEventKind.cancel {
                root.middle-armed = false;
                root.right-armed = false;
            } else if event.button == PointerEventButton.middle {
                if event.kind == PointerEventKind.down {
                    root.middle-armed = root.enabled;
                } else if event.kind == PointerEventKind.up {
                    if root.middle-armed && root.enabled && self.has-hover {
                        root.middle-clicked();
                    }
                    root.middle-armed = false;
                }
            } else if event.button == PointerEventButton.right {
                if event.kind == PointerEventKind.down {
                    root.right-armed = root.enabled;
                } else if event.kind == PointerEventKind.up {
                    if root.right-armed && root.enabled && self.has-hover {
                        root.context-requested({
                            x: root.absolute-position.x + self.mouse-x,
                            y: root.absolute-position.y + self.mouse-y
                        });
                    }
                    root.right-armed = false;
                }
            }
        }
    }

    if root.show-focus-ring && root.focus-visible: Rectangle {
        x: -FocusTokens.outer-margin;
        y: -FocusTokens.outer-margin;
        width: parent.width + 2 * FocusTokens.outer-margin;
        height: parent.height + 2 * FocusTokens.outer-margin;
        border-radius: root.radius + FocusTokens.outer-margin;
        border-width: FocusTokens.outline-width;
        border-color: SeelenPalette.accent;
        accessible-role: none;
    }

    // Children (icons, glyphs, indicators) render above the state layers.
    @children
}

// Genuine host icon when available; a small independent application glyph
// when icon extraction fails. Missing images never leave invisible buttons.
export component ApplicationIcon inherits Rectangle {
    in property <image> source;
    accessible-role: none;
    Image {
        source: root.source;
        image-fit: ImageFit.contain;
        accessible-role: none;
    }
    if root.source.width == 0 || root.source.height == 0: Rectangle {
        x: parent.width * 0.15;
        y: parent.height * 0.15;
        width: parent.width * 0.7;
        height: parent.height * 0.7;
        border-radius: parent.width * 0.1;
        border-width: 1.5px;
        border-color: SeelenPalette.secondary;
        accessible-role: none;
        Rectangle {
            x: 2px;
            y: parent.height * 0.25;
            width: max(0px, parent.width - 4px);
            height: 1.5px;
            background: SeelenPalette.secondary;
            accessible-role: none;
        }
    }
}
