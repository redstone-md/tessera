import { SeelenPalette } from "palette.slint";

// One Seelen-style clickable tile (dock items, launcher tiles, toolbar
// entries): a rounded rectangle with hover/pressed/focus states and a
// focusable keyboard handler (Space/Return activate) — the stock
// StateLayer pattern from the toolkit's own widgets.
//
// `clicked` fires only when enabled; disabled tiles dim and reject input.
// `accessible-role`/label make every tile a real button for the platform's
// accessibility tree.
export struct TileBounds { origin: Point, width: length, height: length }

// External outlines need the same reserved space in clipped viewports.
export global FocusTokens {
    in-out property <length> outline-width: 2px;
    in-out property <length> outline-offset: 2px;
    out property <length> outer-margin: self.outline-width + self.outline-offset;
}

export component TileButton inherits Rectangle {
    in property <string> accessible-text;
    in property <string> tooltip-text;
    in property <bool> enabled: true;
    // Passive presentation keeps enabled appearance without input or AX actions.
    in property <bool> interactive: true;
    // Non-idempotent actions may require a fresh Return press for each effect.
    in property <bool> allow-return-repeat: true;
    // Opaque actor-issued authority, never a caption. Existing tiles need no key.
    in property <string> activation-key: "";
    // Semantic selection is independent of real focus and input modality.
    in property <bool> selected: false;
    // Optional metadata only: the stable parent DragArea owns recognition.
    in property <bool> report-pointer-metadata: false;
    callback pointer-metadata(PointerEvent, TileBounds, Point);
    out property <bool> hovered: root.interactive && touch.has-hover;
    out property <bool> pressed: root.interactive && root.enabled
        && ((touch.pressed && root.left-armed && root.left-key == root.activation-key)
            || (root.space-armed && root.space-key == root.activation-key));
    // Actual native focus, independent of keyboard-only outline modality.
    out property <bool> has-focus: root.interactive && keyboard.has-focus;
    out property <bool> focus-visible: root.interactive && root.keyboard-focus && keyboard.has-focus && root.enabled;
    // Stock command surfaces may activate without changing the current focus.
    in property <bool> focus-on-pointer: true;
    in property <length> radius;
    in property <bool> show-focus-ring: true;
    property <bool> keyboard-focus;
    property <bool> space-armed;
    property <string> space-key;
    property <bool> return-armed;
    property <string> return-key;
    property <bool> left-armed;
    property <string> left-key;
    property <bool> right-armed;
    property <string> right-key;
    property <bool> middle-armed;
    property <string> middle-key;
    // Call synchronously before hiding or rebinding a persistent source.
    // Reactive changed handlers may coalesce a transient false -> true.
    public function cancel-input() {
        root.space-armed = false;
        root.return-armed = false;
        root.left-armed = false;
        root.right-armed = false;
        root.middle-armed = false;
        root.space-key = "";
        root.return-key = "";
        root.left-key = "";
        root.right-key = "";
        root.middle-key = "";
    }
    function pointer-inside() -> bool {
        return touch.mouse-x >= 0px && touch.mouse-y >= 0px
            && touch.mouse-x < root.width && touch.mouse-y < root.height;
    }
    /// false renders no idle background (transparent until hover/press).
    in property <bool> filled: true;
    public function focus-for-keyboard() {
        if root.interactive && root.enabled {
            keyboard.focus();
            root.keyboard-focus = true;
        }
    }
    callback clicked;
    callback middle-clicked;
    callback focus-acquired;
    callback context-requested(Point);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point); // delay and source tile origin
    function dismiss-tooltip(delayed: bool) {
        if root.interactive {
            root.tooltip-dismissed(delayed, root.absolute-position);
        }
    }
    function update-tooltip() {
        if root.interactive && root.enabled && root.hovered && root.tooltip-text != "" {
            root.tooltip-requested(root.tooltip-text, {
                origin: root.absolute-position,
                width: root.width,
                height: root.height
            });
        } else {
            root.dismiss-tooltip(false);
        }
    }
    function activate() {
        if root.interactive && root.enabled {
            let key = root.activation-key;
            root.dismiss-tooltip(false);
            if root.interactive && root.enabled && root.activation-key == key {
                root.clicked();
            }
        }
    }
    changed hovered => {
        if root.hovered {
            root.update-tooltip();
        } else if root.tooltip-text != "" {
            root.dismiss-tooltip(true);
        }
    }
    changed tooltip-text => { if root.hovered { root.update-tooltip(); } }
    changed enabled => {
        if !root.enabled {
            root.cancel-input();
            root.dismiss-tooltip(false);
            root.keyboard-focus = false;
        }
    }
    changed interactive => {
        if !root.interactive {
            root.cancel-input();
            root.keyboard-focus = false;
            if root.tooltip-text != "" {
                root.tooltip-dismissed(false, root.absolute-position);
            }
        }
    }

    border-radius: root.radius;
    background: !root.enabled ? (root.filled ? SeelenPalette.tile : transparent) :
        root.pressed ? SeelenPalette.pressed :
        root.hovered ? SeelenPalette.hover :
        root.filled ? SeelenPalette.tile : transparent;
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-enabled: root.enabled && root.interactive;
    accessible-label: root.accessible-text;
    accessible-action-default => { if root.interactive && root.enabled { root.activate(); } }


    keyboard := FocusScope {
        // Zero-size: must not react on clicks (only key events); the stock
        // StateLayer pattern from the toolkit's own widgets.
        width: 0px;
        enabled: root.enabled && root.interactive;
        focus-on-tab-navigation: root.interactive;
        focus-gained(reason) => {
            if !root.interactive { return; }
            // Window/popup reactivation preserves the existing modality.
            if reason == FocusReason.tab-navigation || reason == FocusReason.programmatic {
                root.keyboard-focus = true;
            } else if reason == FocusReason.pointer-click {
                root.keyboard-focus = false;
            }
            root.focus-acquired();
        }
        focus-lost(reason) => { root.cancel-input(); }
        key-pressed(event) => {
            if root.interactive && root.enabled && event.text == Key.Space {
                root.keyboard-focus = true;
                // Repeats cannot revive a cancelled gesture.
                if !event.repeat {
                    root.space-key = root.activation-key;
                    root.space-armed = true;
                }
                root.dismiss-tooltip(false);
                return accept;
            }
            if root.interactive && root.enabled && event.text == Key.Return {
                root.keyboard-focus = true;
                if !event.repeat {
                    root.return-key = root.activation-key;
                    root.return-armed = true;
                }
                if root.return-armed && root.return-key == root.activation-key
                    && (!event.repeat || root.allow-return-repeat) {
                    root.activate();
                }
                return accept;
            }
            if root.interactive && root.enabled && (event.text == Key.Menu
                || (event.text == Key.F10 && event.modifiers.shift)) {
                root.dismiss-tooltip(false);
                root.keyboard-focus = true;
                root.context-requested({
                    x: root.absolute-position.x + root.width / 2,
                    y: root.absolute-position.y + root.height / 2
                });
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == Key.Return {
                root.return-armed = false;
                root.return-key = "";
                return accept;
            }
            if root.interactive && event.text == Key.Space {
                let activate = root.enabled && root.space-armed
                    && root.space-key == root.activation-key;
                root.space-armed = false;
                root.space-key = "";
                if activate { root.activate(); }
                return accept;
            }
            return reject;
        }
    }
    forward-focus: keyboard;

    touch := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => {
            // Native clicked precedes pointer-event(up); do not synthesize a click.
            let activate = root.left-armed && root.left-key == root.activation-key
                && root.pointer-inside();
            root.left-armed = false;
            root.left-key = "";
            if activate { root.activate(); }
        }
        forward-focus: keyboard;
        scroll-event(event) => {
            root.dismiss-tooltip(false);
            return reject; // preserve the parent ScrollView's real scrolling
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.cancel { root.cancel-input(); }
            if !root.interactive { return; }
            if event.kind == PointerEventKind.down {
                // Capture before external metadata/focus callbacks can rebind.
                if event.button == PointerEventButton.left {
                    root.left-key = root.activation-key;
                    root.left-armed = root.enabled;
                } else if event.button == PointerEventButton.middle {
                    root.middle-key = root.activation-key;
                    root.middle-armed = root.enabled;
                } else if event.button == PointerEventButton.right {
                    root.right-key = root.activation-key;
                    root.right-armed = root.enabled;
                }
            } else if event.kind == PointerEventKind.up
                && event.button == PointerEventButton.left && !root.pointer-inside() {
                // An outside native release has no clicked callback.
                root.left-armed = false;
                root.left-key = "";
            }
            if root.interactive && root.report-pointer-metadata && event.kind != PointerEventKind.move {
                root.pointer-metadata(event, {
                    origin: root.absolute-position,
                    width: root.width, height: root.height
                }, {
                    x: root.absolute-position.x + self.mouse-x,
                    y: root.absolute-position.y + self.mouse-y
                });
            }
            if event.kind == PointerEventKind.down || event.kind == PointerEventKind.cancel {
                root.dismiss-tooltip(false);
            }
            if root.interactive && root.focus-on-pointer && event.kind == PointerEventKind.down {
                // forward-focus redirects focus requests, not TouchArea
                // clicks. This is item focus, not a host foreground request.
                keyboard.focus();
                root.keyboard-focus = false;
            }
            if event.kind == PointerEventKind.up && event.button == PointerEventButton.middle {
                let activate = root.interactive && root.middle-armed && root.enabled
                    && root.middle-key == root.activation-key && root.pointer-inside();
                root.middle-armed = false;
                root.middle-key = "";
                if activate { root.middle-clicked(); }
            } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.right {
                // has-hover stays true during a grabbed release, even outside.
                let activate = root.interactive && root.right-armed && root.enabled
                    && root.right-key == root.activation-key && root.pointer-inside();
                let position = {
                    x: root.absolute-position.x + self.mouse-x,
                    y: root.absolute-position.y + self.mouse-y
                };
                root.right-armed = false;
                root.right-key = "";
                if activate { root.context-requested(position); }
            }
        }
    }

    if root.show-focus-ring && root.enabled && (root.selected || root.focus-visible): Rectangle {
        x: -FocusTokens.outer-margin;
        y: -FocusTokens.outer-margin;
        width: parent.width + 2 * FocusTokens.outer-margin;
        height: parent.height + 2 * FocusTokens.outer-margin;
        border-radius: root.radius + FocusTokens.outer-margin;
        border-width: FocusTokens.outline-width;
        border-color: SeelenPalette.accent;
        accessible-role: none;
    }

    // Children (icons, glyphs, indicators) render above the state layers.
    @children
}

// Genuine host icon when available; a small independent application glyph
// when icon extraction fails. Missing images never leave invisible buttons.
export component ApplicationIcon inherits Rectangle {
    in property <image> source;
    accessible-role: none;
    Image {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        source: root.source;
        image-fit: ImageFit.contain;
        accessible-role: none;
    }
    if root.source.width == 0 || root.source.height == 0: Rectangle {
        x: parent.width * 0.15;
        y: parent.height * 0.15;
        width: parent.width * 0.7;
        height: parent.height * 0.7;
        border-radius: parent.width * 0.1;
        border-width: 1.5px;
        border-color: SeelenPalette.secondary;
        accessible-role: none;
        Rectangle {
            x: 2px;
            y: parent.height * 0.25;
            width: max(0px, parent.width - 4px);
            height: 1.5px;
            background: SeelenPalette.secondary;
            accessible-role: none;
        }
    }
}

// Viewport commands keep native Tab/AX traversal, but a clipped invocation
// only reveals the exact row. Geometry changes retire held native input.
export component ViewportTileButton inherits TileButton {
    in property <TileBounds> clip-bounds;
    property <TileBounds> frame: { origin: root.absolute-position, width: root.width, height: root.height };
    property <bool> frame-visible: root.frame.width > 0px && root.frame.height > 0px
        && root.frame.origin.x >= root.clip-bounds.origin.x
        && root.frame.origin.y >= root.clip-bounds.origin.y
        && root.frame.origin.x + root.frame.width <= root.clip-bounds.origin.x + root.clip-bounds.width
        && root.frame.origin.y + root.frame.height <= root.clip-bounds.origin.y + root.clip-bounds.height;
    callback scoped-clicked;
    callback reveal-requested(TileBounds);
    changed frame => { root.cancel-input(); }
    changed clip-bounds => { root.cancel-input(); }
    focus-acquired => { root.reveal-requested(root.frame); }
    clicked => {
        if root.frame-visible {
            root.scoped-clicked();
        } else {
            root.reveal-requested(root.frame);
        }
    }
}
