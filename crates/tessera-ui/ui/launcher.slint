import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { PopoverBody } from "popover.slint";
import { ApplicationIcon, TileButton, FocusTokens } from "tiles.slint";

export struct LaunchTile {
    key: string,
    label: string,
    icon: image,
    favorite: bool,
}

export enum LauncherNavigation { up, down, left, right }
export enum LauncherView { favorites, all }

// Frameless OPAQUE centered launcher (source apps-menu has no translucency):
// a search header, a 7-column icon grid of
// genuine cached application icons, and a footer with settings/recovery and
// exit. Seelen apps-menu facts: 7 columns, 8px gap, 16px body inset, square tiles with
// icon and a 0.8rem name, radius 10. Escape hides the window (FocusScope at
// the window level). No fake media, tray, or workspace data is rendered.
export component Launcher inherits Window {
    no-frame: true;
    background: transparent;
    title: "Tessera applications";
    min-width: 1px;
    min-height: 1px;

    in property <[LaunchTile]> tiles;
    in property <LauncherView> view: LauncherView.favorites;
    in property <bool> saved-favorites-present;
    in property <string> status;
    in property <string> notice;
    in property <bool> refreshing;
    in property <bool> stale;
    in property <string> user-name;
    in property <string> version;
    in-out property <string> search;
    in property <string> selected-key: "";
    out property <int> grid-columns: 7;
    callback navigate-requested(LauncherNavigation);
    callback activate-selected-requested();
    callback select-requested(string);
    callback search-changed();
    callback launch-requested(string);
    callback favorite-toggle-requested(string, bool);
    callback view-requested(LauncherView);
    callback open-settings-requested();
    callback refresh-requested();
    callback hide-requested();
    callback exit-requested();
    callback focus-search();
    focus-search => {
        root.grid-navigation = false;
        search-field.focus();
    }

    // A fresh view/reopen starts at the top without taking keyboard focus.
    public function reset-scroll() {
        grid-scroll.content-y = 0px;
    }

    // Nearest-row scrolling includes the shared external outline gutter.
    // Selection stays host-owned; scrolling never changes keyboard focus.
    public function ensure-visible(index: int) {
        if index >= 0 && index < root.tiles.length {
            let top = floor(index / root.grid-columns) * (grid-scroll.tile + root.gap);
            let bottom = top + grid-scroll.tile + 2 * FocusTokens.outer-margin;
            let visible-top = -grid-scroll.content-y;
            let target = top < visible-top ? top :
                bottom > visible-top + grid-scroll.visible-height ?
                    bottom - grid-scroll.visible-height : visible-top;
            grid-scroll.content-y = -clamp(target, 0px,
                max(0px, grid-scroll.content-height - grid-scroll.visible-height));
        }
    }
    property <length> gap: 8px;
    property <length> pad: 8px;
    property <bool> blocked: root.refreshing || root.stale;
    // Only arrows originating in the grid move real tile focus. Search
    // preselection stays semantic so native text editing retains focus.
    property <bool> grid-navigation: false;

    changed search => {
        root.grid-navigation = false;
        root.search-changed();
    }

    body := PopoverBody {
        surface-radius: 16px;

        // Search receives focus on each show; Escape bubbles from all of
        // this scope's children, including the search field and favorite controls.
        escape-scope := FocusScope {
            width: body.content-width;
            height: body.content-height;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.hide-requested();
                    return accept;
                }
                return reject;
            }

        VerticalLayout {
            padding: root.pad;
            spacing: root.pad;

            // Genuine data-view navigation; the host accepts and resets a view.
            HorizontalLayout {
                spacing: root.pad;
            search-field := LineEdit {
                horizontal-stretch: 1;
                accessible-label: "Search applications";
                placeholder-text: "Search applications";
                text <=> root.search;
                enabled: true;
                changed has-focus => {
                    if self.has-focus { root.grid-navigation = false; }
                }
                key-pressed(event) => {
                    if event.modifiers.control || event.modifiers.alt
                        || event.modifiers.shift || event.modifiers.meta { return reject; }
                    if event.text == Key.Return {
                        if !root.blocked && root.selected-key != "" && !event.repeat {
                            root.activate-selected-requested();
                        }
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        if !root.blocked {
                            root.navigate-requested(event.text == Key.UpArrow ?
                                LauncherNavigation.up : LauncherNavigation.down);
                        }
                        return accept;
                    }
                    // Native LineEdit exposes no caret getter in the pinned SDK.
                    // Left/Right remain normal editing, including Right at end.
                    return reject;
                }
            }
                Button {
                    text: root.view == LauncherView.favorites ? "All Apps" : "Back";
                    accessible-label: root.view == LauncherView.favorites ? "All Apps" : "Back to favorites";
                    enabled: !root.blocked;
                    clicked => {
                        if !root.blocked {
                            root.view-requested(root.view == LauncherView.favorites ?
                                LauncherView.all : LauncherView.favorites);
                        }
                    }
                }
            }

            // Grid: 7 columns of square tiles; overflow scrolls.
            HorizontalLayout {
                // Total body inset: root padding 8 + inner padding 4 +
                // outline gutter 4 = the reference 16px (not an 8px grid).
                padding: max(0px, root.pad - FocusTokens.outer-margin);
                vertical-stretch: 1;
            grid-key := FocusScope {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-width: 50px;
                min-height: 50px;
                focus-on-tab-navigation: false;
                key-pressed(event) => {
                    if event.modifiers.control || event.modifiers.alt
                        || event.modifiers.shift || event.modifiers.meta { return reject; }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow
                        || event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        if !root.blocked {
                            root.grid-navigation = true;
                            root.navigate-requested(event.text == Key.UpArrow ? LauncherNavigation.up :
                                event.text == Key.DownArrow ? LauncherNavigation.down :
                                event.text == Key.LeftArrow ? LauncherNavigation.left : LauncherNavigation.right);
                        }
                        return accept;
                    }
                    // Return/Space belong to each tile or its favorite control.
                    return reject;
                }
            grid-scroll := ScrollView {
                width: parent.width;
                height: parent.height;
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                property <length> tile: (self.visible-width - 2 * FocusTokens.outer-margin
                    - (root.grid-columns - 1) * root.gap) / root.grid-columns;
                property <int> rows: ceil(root.tiles.length / root.grid-columns);
                content-width: self.visible-width;
                content-height: max(self.visible-height, 2 * FocusTokens.outer-margin
                    + max(0px, self.rows * (self.tile + root.gap) - root.gap));

                for tile[i] in root.tiles: Rectangle {
                    property <int> column-index: mod(i, root.grid-columns);
                    property <int> row-index: floor(i / root.grid-columns);
                    property <length> size: grid-scroll.tile;
                    x: FocusTokens.outer-margin + self.column-index * (self.size + root.gap);
                    y: FocusTokens.outer-margin + self.row-index * (self.size + root.gap);
                    width: self.size;
                    height: self.size;

                    TileButton {
                        width: parent.width;
                        height: parent.height;
                        radius: 10px;
                        filled: false;
                        enabled: !root.blocked;
                        selected: tile.key == root.selected-key;
                        property <bool> keyboard-selected: root.grid-navigation && self.selected;
                        changed keyboard-selected => {
                            if self.keyboard-selected { self.focus-for-keyboard(); }
                        }
                        focus-acquired => { root.select-requested(tile.key); }
                        transform-scale: self.pressed ? 0.95 : 1;
                        background: !self.enabled ? transparent :
                            (self.selected || self.focus-visible) ? SeelenPalette.accent.with-alpha(0.1) :
                            self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
                        accessible-text: "Launch " + tile.label;
                        clicked => { root.launch-requested(tile.key); }

                        // Clip icon/name content, not the external focus ring.
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            clip: true;
                            VerticalLayout {
                                padding: root.pad;
                                spacing: root.gap;
                                ApplicationIcon { source: tile.icon; }
                                Text {
                                    text: tile.label;
                                    color: SeelenPalette.foreground;
                                    font-size: 12.8px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    height: 35.2px;
                                    overflow: elide;
                                    accessible-role: none;
                                }
                            }
                        }

                        // A genuine favorite action using the shared native
                        // tile's focus, Space release and accessible activation.
                        TileButton {
                            width: 16px;
                            height: 16px;
                            x: parent.width - self.width;
                            y: 0px;
                            radius: 4px;
                            filled: false;
                            enabled: !root.blocked;
                            accessible-role: checkbox;
                            accessible-checked: tile.favorite;
                            accessible-text: (tile.favorite ? "Remove from favorites: " :
                                "Add to favorites: ") + tile.label;
                            clicked => {
                                root.favorite-toggle-requested(tile.key, !tile.favorite);
                            }

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                x: (parent.width - 8px) / 2;
                                y: (parent.height - 8px) / 2;
                                border-radius: 4px;
                                background: tile.favorite ? SeelenPalette.accent : SeelenPalette.muted;
                                accessible-role: none;
                            }
                        }
                    }
                }

                if root.tiles.length == 0: Text {
                    x: 0;
                    y: (grid-scroll.visible-height - self.preferred-height) / 2;
                    width: grid-scroll.visible-width;
                    text: root.blocked ? "Working; results appear after the current refresh." :
                        root.view == LauncherView.all ? "No matching applications." :
                        root.saved-favorites-present ? "Saved favorites are unavailable. Refresh to check installed applications." :
                        "Welcome to Tessera.\nYour favorite applications appear here. Open All Apps to add favorites.";
                    color: SeelenPalette.secondary;
                    font-italic: true;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
            }
            }

            // Status line and footer: settings/recovery, refresh, exit — all
            // reachable even while refreshing or stale (rescue actions).
            if root.notice != "": Text {
                text: root.notice;
                color: SeelenPalette.secondary;
                font-size: 11px;
                wrap: word-wrap;
                accessible-role: text;
            }
            Text {
                text: root.status;
                color: SeelenPalette.secondary;
                font-size: 11px;
                overflow: elide;
                accessible-role: text;
            }
            HorizontalLayout {
                spacing: root.pad;
                alignment: end;

                Button {
                    text: root.user-name == "" ? "Settings" : root.user-name;
                    accessible-label: "Open settings and recovery";
                    clicked => { root.open-settings-requested(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Refresh";
                    enabled: !root.refreshing;
                    accessible-label: "Refresh the desktop";
                    clicked => { root.refresh-requested(); }
                }
                Button {
                    text: "Exit";
                    accessible-label: "Exit Tessera";
                    clicked => { root.exit-requested(); }
                }
            }
        }
        }
    }
}
