import { ListView } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";
import { PopoverBody, PopoverTokens } from "popover.slint";
import { TileButton, FocusTokens, TileBounds } from "tiles.slint";
import { LauncherTile, LaunchTile } from "launcher-tile.slint";
import { Slint1181FluentNativeGridMetrics } from "native-grid-metrics.slint";

export { LaunchTile } from "launcher-tile.slint";

// A launcher-local skin around the public native editor. The pinned LineEdit
// interface exposes no fill, border or padding; TextInput owns editing and IME.
component LauncherSearchField inherits Rectangle {
    in-out property <string> text <=> editor.text;
    out property <bool> has-focus: editor.has-focus;
    callback key-pressed(KeyEvent) -> EventResult;
    min-width: 1px;
    min-height: 32.4px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: transparent;
    background: transparent;
    forward-focus: editor;
    viewport := Rectangle {
        x: 9px;
        y: 5px;
        width: max(1px, root.width - 18px);
        height: max(1px, root.height - 10px);
        clip: true;
        accessible-role: none;
        // Public TextInput has no preedit getter. Do not paint a placeholder
        // over composition text or depend on the SDK's private preedit property.
        Text {
            width: parent.width;
            height: parent.height;
            text: root.text == "" && !root.has-focus ? @tr("Applications") : "";
            font-size: SeelenPalette.reference-mode ? 16px : SeelenPalette.body-font-size;
            font-family: PopoverTokens.font-family;
            color: SeelenPalette.secondary;
            vertical-alignment: center;
            accessible-role: none;
        }
        ContextMenuArea {
            Menu {
                MenuItem { title: @tr("Undo"); activated => { editor.undo(); } }
                MenuItem { title: @tr("Redo"); activated => { editor.redo(); } }
                MenuSeparator {}
                MenuItem { title: @tr("Cut"); activated => { editor.cut(); } }
                MenuItem { title: @tr("Copy"); activated => { editor.copy(); } }
                MenuItem { title: @tr("Paste"); activated => { editor.paste(); } }
                MenuItem { title: @tr("Select All"); activated => { editor.select-all(); } }
            }
            editor := TextInput {
                property <length> scroll-x: 0px;
                x: clamp(self.scroll-x,
                    min(0px, viewport.width - self.width), 0px);
                width: max(viewport.width, self.preferred-width + self.text-cursor-width);
                height: viewport.height;
                single-line: true;
                font-size: SeelenPalette.reference-mode ? 16px : SeelenPalette.body-font-size;
                font-family: PopoverTokens.font-family;
                color: SeelenPalette.foreground;
                vertical-alignment: center;
                accessible-label: @tr("Search applications");
                accessible-placeholder-text: @tr("Applications");
                cursor-position-changed(point) => {
                    if point.x + self.x < 0px {
                        self.scroll-x = -point.x;
                    } else if point.x + self.x + self.text-cursor-width > viewport.width {
                        self.scroll-x = viewport.width - point.x - self.text-cursor-width;
                    }
                }
                key-pressed(event) => { return root.key-pressed(event); }
            }
        }
    }
}

// Header/recovery commands retain the shared keyboard/pointer owner.
component LauncherCommandButton inherits TileButton {
    in property <string> text;
    in property <string> input-scope;
    activation-key: root.input-scope + root.accessible-text;
    min-width: label.preferred-width + 16px;
    min-height: 30.4px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    radius: 6px;
    background: SeelenPalette.tile;
    transform-scale: root.pressed ? 0.98 : 1;
    drop-shadow-color: #00000014;
    drop-shadow-offset-x: 1px;
    drop-shadow-offset-y: 1px;
    drop-shadow-blur: 2px;
    allow-return-repeat: false;
    focus-on-pointer: false;
    label := Text {
        x: 8px;
        width: max(0px, root.width - 16px);
        height: root.height;
        text: root.text;
        font-family: PopoverTokens.font-family;
        font-size: SeelenPalette.reference-mode ? 16px : SeelenPalette.body-font-size;
        color: !root.enabled ? SeelenPalette.muted :
            root.hovered ? SeelenPalette.accent : SeelenPalette.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
}

component LauncherFooterButton inherits TileButton {
    height: 32px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    radius: 6px;
    filled: false;
    allow-return-repeat: false;
    background: !root.enabled ? transparent :
        root.pressed ? SeelenPalette.accent.with-alpha(0.3) :
        root.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
    transform-scale: root.pressed ? 0.98 : 1;
}

export struct LauncherDragVisual {
    visible: bool,
    source: LaunchTile,
    bounds: TileBounds,
    source-scale: float,
}

export struct LaunchRow {
    tiles: [LaunchTile],
}

// Window-logical coordinates, not physical pixels or private widget handles.
export struct LauncherGridMetrics {
    viewport: TileBounds,
    source-width: length,
    tile: length,
    gap: length,
    gutter: length,
    columns: int,
    content-y: length,
    content-height: length,
}

export enum LauncherNavigation { up, down, left, right }
export enum LauncherView { favorites, all }
export enum LauncherDisplayMode { Windowed, Fullscreen }

// Frameless OPAQUE centered launcher (source apps-menu has no translucency):
// a transparent native search header, a 7-column genuine application grid,
// and a profile/icon footer. Explicit feedback owns a separate recovery band.
// Seelen apps-menu facts: 7 columns, 8px gap, 16px body inset, square tiles with
// icon and a 0.8rem name, radius 10. Escape hides the window (FocusScope at
// the window level). No fake media, tray, or workspace data is rendered.
export component Launcher inherits Window {
    default-font-family: SeelenPalette.font-family;
    no-frame: true;
    background: transparent;
    title: "Tessera applications";
    min-width: 1px;
    min-height: 1px;

    in property <[LaunchRow]> rows;
    in property <int> application-count;
    in property <LauncherView> view: LauncherView.favorites;
    // Product layout is monitor geometry, never the Window.fullscreen flag.
    in property <LauncherDisplayMode> display-mode: LauncherDisplayMode.Windowed;
    in property <bool> saved-favorites-present;
    in property <string> status;
    in property <string> notice;
    in property <bool> refreshing;
    in property <bool> stale;
    in property <bool> feedback-visible: false;
    in property <string> user-name;
    in property <string> version;
    in-out property <string> search;
    in property <string> selected-key: "";
    out property <int> grid-columns: 7;
    property <int> input-generation: 0;
    property <bool> input-exhausted: false;
    property <string> input-scope: "launcher/" + root.input-generation + ":";
    out property <bool> input-available: !root.input-exhausted;
    in property <bool> reorder-enabled: false;
    in property <data-transfer> reorder-data;
    in property <LauncherDragVisual> reorder-visual;
    out property <bool> reorder-dragging: grid-drag.dragging;
    // Transient appearance metadata; gesture capture, not this property, owns it.
    in-out property <float> source-appearance-scale: 1;
    // Source geometry must not depend on the metrics' own window transform.
    property <length> reorder-source-width: Slint1181FluentNativeGridMetrics.source-width(
        grid-scroll.visible-width, grid-scroll.content-height,
        grid-scroll.visible-height, grid-scroll.vertical-scrollbar-policy);
    out property <LauncherGridMetrics> reorder-metrics: {
        viewport: {
            origin: grid-scroll.absolute-position,
            width: grid-scroll.visible-width, height: grid-scroll.visible-height
        },
        source-width: root.reorder-source-width,
        tile: grid-scroll.tile, gap: root.gap, gutter: FocusTokens.outer-margin,
        columns: root.grid-columns,
        content-y: grid-scroll.content-y, content-height: grid-scroll.content-height
    };
    property <bool> reorder-armed: true;
    callback reorder-origin(string, PointerEvent, TileBounds, Point);
    callback reorder-dragging-changed(bool);
    callback reorder-can-drop(DropEvent, Point) -> DragAction;
    callback reorder-window-hover(DropEvent, Point);
    callback reorder-dropped(DropEvent, Point) -> DragAction;
    callback reorder-finished(DragAction);
    callback reorder-metrics-changed();
    callback reorder-target-changed(bool);
    changed reorder-metrics => {
        root.tooltip-cancelled();
        root.reorder-metrics-changed();
    }
    function veto-reorder(event: PointerEvent, bounds: TileBounds, point: Point) {
        if event.kind == PointerEventKind.down {
            root.reorder-armed = false;
        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
            root.reorder-armed = true;
        }
        if event.kind != PointerEventKind.move {
            root.reorder-origin("", event, bounds, point);
        }
    }
    function retain-reorder-focus() {
        // Preview/virtualization can destroy the focused source delegate.
        // Native key delivery has no ancestor fallback for an expired focus
        // item, so retain a real, stable grid focus before publishing preview.
        // This is internal item focus, not search focus or a host focus request.
        if root.reorder-dragging {
            // Existing selected-tile focus resumes when dragging becomes false.
            // Set this at activation, never after finish: reopen's focus-search
            // can still clear it without a stale finish stealing search focus.
            root.grid-navigation = true;
            if !grid-key.has-focus { grid-key.focus(); }
        }
    }
    callback navigate-requested(LauncherNavigation);
    callback activate-selected-requested();
    callback select-requested(string);
    callback search-changed();
    callback launch-requested(string);
    callback favorite-toggle-requested(string, bool);
    callback app-menu-requested(string, Point);
    callback view-requested(LauncherView);
    callback display-mode-requested(LauncherDisplayMode);
    callback open-settings-requested();
    callback open-user-menu-requested(TileBounds);
    callback open-power-menu-requested();
    callback refresh-requested();
    callback hide-requested();
    callback exit-requested();
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point);
    callback tooltip-cancelled();
    // A nonhover keyboard/AX command never owned the foreign surface's hint.
    // Its Root action still retires other owners at its guarded transaction seam.
    function dismiss-source-tooltip(delayed: bool, origin: Point, hovered: bool) {
        if delayed || hovered { root.tooltip-dismissed(delayed, origin); }
    }
    callback focus-search();
    focus-search => {
        root.grid-navigation = false;
        search-field.focus();
    }

    // Root calls this before hide/reopen or any query/projection replacement.
    // Scoped keys revoke virtual delegates synchronously when input is checked;
    // named commands also release their held visual/input state immediately.
    public function cancel-input() {
        root.tooltip-cancelled();
        if root.input-generation < 2147483647 {
            root.input-generation += 1;
        } else {
            root.input-exhausted = true;
        }
        view-command.cancel-input();
        user-command.cancel-input();
        settings-command.cancel-input();
        power-command.cancel-input();
        mode-command.cancel-input();
    }

    // A fresh view/reopen starts at the top without taking keyboard focus.
    public function reset-scroll() {
        grid-scroll.content-y = 0px;
    }

    // Gesture owner supplies a signed content-y step; native extent owns clamp.
    public function scroll-reorder(delta: length) {
        grid-scroll.content-y = clamp(grid-scroll.content-y + delta,
            -max(0px, grid-scroll.content-height - grid-scroll.visible-height), 0px);
    }

    // Nearest-row scrolling includes the shared external outline gutter.
    // Selection stays host-owned; scrolling never changes keyboard focus.
    public function ensure-visible(index: int) {
        if index >= 0 && index < root.application-count {
            let top = floor(index / root.grid-columns) * (grid-scroll.tile + root.gap);
            let bottom = top + grid-scroll.tile + 2 * FocusTokens.outer-margin;
            let visible-top = -grid-scroll.content-y;
            if top < visible-top || bottom > visible-top + grid-scroll.visible-height {
                let target = top < visible-top ? top : bottom - grid-scroll.visible-height;
                grid-scroll.content-y = -clamp(target, 0px,
                    max(0px, grid-scroll.content-height - grid-scroll.visible-height));
            }
        }
    }
    property <length> gap: 8px;
    property <length> pad: 8px;
    property <float> empty-line-height-factor: empty-font-metrics.preferred-height > 0px
        ? 22.4px / empty-font-metrics.preferred-height : 1;
    empty-font-metrics := Text {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: "M";
        font-family: PopoverTokens.font-family;
        font-size: 16px;
        font-weight: 600;
        font-italic: true;
        accessible-role: none;
    }
    property <bool> blocked: root.refreshing || root.stale || root.input-exhausted;
    changed blocked => { if root.blocked { root.tooltip-cancelled(); } }
    // Only arrows originating in the grid move real tile focus. Search
    // preselection stays semantic so native text editing retains focus.
    property <bool> grid-navigation: false;

    changed search => {
        root.grid-navigation = false;
        root.search-changed();
    }

    // Rejecting observer: feedback may follow outside the grid, but only the
    // existing grid target can authorize a drop or drive domain autoscroll.
    DropArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.reorder-enabled && root.reorder-dragging;
        can-drop(event) => {
            if root.reorder-enabled && root.reorder-dragging {
                root.retain-reorder-focus();
                root.reorder-window-hover(event, self.absolute-position);
            }
            return DragAction.none;
        }
        dropped(event) => { return DragAction.none; }
    }

    body := PopoverBody {
        surface-radius: root.display-mode == LauncherDisplayMode.Fullscreen ? 0px : 16px;
        shadow-margin: root.display-mode == LauncherDisplayMode.Fullscreen ? 0px : PopoverTokens.shadow-margin;
        shadow-enabled: root.display-mode != LauncherDisplayMode.Fullscreen;

        // Search receives focus on each show; Escape bubbles from all of
        // this scope's children, including the search field and favorite controls.
        escape-scope := FocusScope {
            width: body.content-width;
            height: body.content-height;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.hide-requested();
                    return accept;
                }
                return reject;
            }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            // Genuine data-view navigation; the host accepts and resets a view.
            HorizontalLayout {
                padding: root.pad;
                spacing: root.pad;
            search-field := LauncherSearchField {
                text <=> root.search;
                changed has-focus => {
                    if self.has-focus { root.grid-navigation = false; }
                }
                key-pressed(event) => {
                    if event.modifiers.control || event.modifiers.alt
                        || event.modifiers.shift || event.modifiers.meta { return reject; }
                    if event.text == Key.Return {
                        if !root.blocked && root.selected-key != "" && !event.repeat {
                            root.activate-selected-requested();
                        }
                        return accept;
                    }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow {
                        if !root.blocked {
                            root.navigate-requested(event.text == Key.UpArrow ?
                                LauncherNavigation.up : LauncherNavigation.down);
                        }
                        return accept;
                    }
                    // Left/Right remain native caret/selection editing.
                    return reject;
                }
            }
                view-command := LauncherCommandButton {
                    input-scope: root.input-scope;
                    text: root.view == LauncherView.favorites ? "All Apps" : "Back";
                    accessible-text: root.view == LauncherView.favorites ? "All Apps" : "Back to favorites";
                    tooltip-text: self.accessible-text;
                    tooltip-requested(content, bounds) => { root.tooltip-requested(content, bounds); }
                    tooltip-dismissed(delayed, origin) => {
                        root.dismiss-source-tooltip(delayed, origin, self.hovered);
                    }
                    enabled: !root.blocked;
                    allow-return-repeat: true;
                    clicked => {
                        if !root.blocked {
                            root.view-requested(root.view == LauncherView.favorites ?
                                LauncherView.all : LauncherView.favorites);
                        }
                    }
                }
            }

            // Grid: 7 columns of square tiles; overflow scrolls.
            HorizontalLayout {
                // The body owns its 16px inset independently of header/footer.
                // Keep the external focus gutter and native hitbox unchanged.
                padding: max(0px, 16px - FocusTokens.outer-margin);
                vertical-stretch: 1;
            grid-key := FocusScope {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-width: 50px;
                min-height: 50px;
                focus-on-tab-navigation: false;
                capture-key-pressed(event) => {
                    // This gesture is pointer-only. Preserve Escape's ancestor
                    // route, but do not navigate/activate tiles or move Tab focus
                    // while the native SDK owns the drag.
                    if root.reorder-dragging && event.text != Key.Escape { return accept; }
                    return reject;
                }
                key-pressed(event) => {
                    if event.modifiers.control || event.modifiers.alt
                        || event.modifiers.shift || event.modifiers.meta { return reject; }
                    if event.text == Key.UpArrow || event.text == Key.DownArrow
                        || event.text == Key.LeftArrow || event.text == Key.RightArrow {
                        if !root.blocked {
                            root.grid-navigation = true;
                            root.navigate-requested(event.text == Key.UpArrow ? LauncherNavigation.up :
                                event.text == Key.DownArrow ? LauncherNavigation.down :
                                event.text == Key.LeftArrow ? LauncherNavigation.left : LauncherNavigation.right);
                        }
                        return accept;
                    }
                    // Return/Space belong to each tile or its favorite control.
                    return reject;
                }
            // Only the full frame participates in layout. Explicit anchors
            // prevent implicit centering of the scrollbar-excluding source.
            grid-frame := Rectangle {
                x: 0px;
                y: 0px;
                width: grid-key.width;
                height: grid-key.height;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                accessible-role: none;
            grid-drag := DragArea {
                x: 0px;
                y: 0px;
                width: root.reorder-source-width;
                height: grid-frame.height;
                enabled: root.reorder-enabled && root.reorder-armed && !root.blocked;
                data: root.reorder-data;
                allow-move: true;
                changed dragging => {
                    root.retain-reorder-focus();
                    root.reorder-dragging-changed(self.dragging);
                }
                drag-finished(action) => { root.reorder-finished(action); }
            grid-drop := DropArea {
                x: 0px;
                y: 0px;
                width: grid-frame.width;
                height: grid-frame.height;
                enabled: root.reorder-enabled && !root.blocked;
                changed has-drag => { root.reorder-target-changed(self.has-drag); }
                can-drop(event) => {
                    // Changed handlers are queued; the first native hover can
                    // replace rows before the dragging-change handler runs.
                    root.retain-reorder-focus();
                    return root.reorder-can-drop(event, self.absolute-position);
                }
                dropped(event) => {
                    return root.reorder-dropped(event, self.absolute-position);
                }
                // Behind the native list: only uncovered viewport background
                // reaches this source veto. Native bars/tiles keep first refusal.
                TouchArea {
                    x: 0px;
                    y: 0px;
                    width: grid-frame.width;
                    height: grid-frame.height;
                    enabled: root.reorder-enabled;
                    pointer-event(event) => {
                        root.veto-reorder(event, {
                            origin: self.absolute-position,
                            width: self.width, height: self.height
                        }, {
                            x: self.absolute-position.x + self.mouse-x,
                            y: self.absolute-position.y + self.mouse-y
                        });
                    }
                }
            grid-scroll := ListView {
                x: 0px;
                y: 0px;
                width: grid-frame.width;
                height: grid-frame.height;
                vertical-stretch: 1;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                property <length> tile: max(1px, (self.visible-width - 2 * FocusTokens.outer-margin
                    - (root.grid-columns - 1) * root.gap) / root.grid-columns);
                content-width: self.visible-width;

                // Native ListView owns row placement, extent and retention.
                // The 8px gap reserves both 4px external outline gutters.
                for row[row-index] in root.rows: Rectangle {
                    width: grid-scroll.visible-width;
                    height: grid-scroll.tile + root.gap;
                    // Gaps/gutters veto source presses, not in-flight hover.
                    TouchArea {
                        enabled: root.reorder-enabled;
                        pointer-event(event) => {
                            root.veto-reorder(event, {
                                origin: self.absolute-position,
                                width: self.width, height: self.height
                            }, {
                                x: self.absolute-position.x + self.mouse-x,
                                y: self.absolute-position.y + self.mouse-y
                            });
                        }
                    }

                    for tile[column-index] in row.tiles: Rectangle {
                        property <length> size: grid-scroll.tile;
                        x: FocusTokens.outer-margin + column-index * (self.size + root.gap);
                        y: FocusTokens.outer-margin;
                        width: self.size;
                        height: self.size;

                        LauncherTile {
                            width: parent.width;
                            height: parent.height;
                            tile: tile;
                            input-scope: root.input-scope;
                            tooltip-text: tile.label;
                            tooltip-requested(content, bounds) => {
                                root.tooltip-requested(content, bounds);
                            }
                            tooltip-dismissed(delayed, origin) => {
                                root.dismiss-source-tooltip(delayed, origin, self.hovered);
                            }
                            // Keep the native slot and its geometry alive.
                            opacity: root.reorder-visual.visible
                                && root.reorder-visual.source.key == tile.key ? 0 : root.blocked ? 0.5 : 1;
                            enabled: !root.blocked;
                            interactive: !(root.reorder-visual.visible
                                && root.reorder-visual.source.key == tile.key);
                            visible: !(root.reorder-visual.visible
                                && root.reorder-visual.source.key == tile.key);
                            // Context presses retain genuine focus without changing
                            // the host's semantic selection or arming a reorder.
                            property <bool> context-pointer-focus;
                            report-pointer-metadata: true;
                            pointer-metadata(event, bounds, point) => {
                                if event.kind == PointerEventKind.down {
                                    self.context-pointer-focus = event.button == PointerEventButton.right;
                                } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                    self.context-pointer-focus = false;
                                }
                                if !root.reorder-enabled { return; }
                                if event.kind == PointerEventKind.down {
                                    root.reorder-armed = event.button == PointerEventButton.left;
                                } else if event.kind == PointerEventKind.up {
                                    root.reorder-armed = true;
                                }
                                // Descendant Cancel precedes the SDK dragging
                                // transition; it must not disarm a valid source.
                                if event.kind == PointerEventKind.down {
                                    root.source-appearance-scale = self.appearance-scale;
                                }
                                root.reorder-origin(tile.key, event, bounds, point);
                            }
                            selected: tile.key == root.selected-key;
                            keyboard-selected: root.grid-navigation
                                && self.selected && !root.reorder-dragging;
                            focus-acquired => {
                                if !self.context-pointer-focus { root.select-requested(tile.key); }
                            }
                            clicked => { root.launch-requested(tile.key); }
                            context-requested(anchor) => {
                                // Pointer capture may retain hover until release;
                                // authority still requires the real source bounds.
                                let origin = self.absolute-position;
                                if !root.blocked && !root.reorder-dragging && self.interactive
                                    && anchor.x >= origin.x && anchor.x < origin.x + self.width
                                    && anchor.y >= origin.y && anchor.y < origin.y + self.height {
                                    root.app-menu-requested(tile.key, anchor);
                                }
                            }
                            favorite-pointer-metadata(event, bounds, point) => {
                                if root.reorder-enabled { root.veto-reorder(event, bounds, point); }
                            }
                            favorite-toggle-requested => {
                                root.favorite-toggle-requested(tile.key, !tile.favorite);
                            }
                        }
                    }
                }
            }
            }
            }
            }

                if root.application-count == 0: VerticalLayout {
                    x: 0px;
                    y: (grid-scroll.visible-height - self.preferred-height) / 2;
                    width: grid-scroll.visible-width;
                    height: self.preferred-height;
                    spacing: 8px;
                    Text {
                        text: root.blocked ? "Working; results appear after the current refresh." :
                            root.view == LauncherView.all ? "No matching applications." :
                            root.saved-favorites-present ? "Saved favorites are unavailable. Refresh to check installed applications." :
                            "Welcome to Tessera.";
                        color: SeelenPalette.secondary;
                        font-family: PopoverTokens.font-family;
                        font-size: 16px;
                        font-weight: 600;
                        font-italic: true;
                        line-height-factor: root.empty-line-height-factor;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        accessible-role: text;
                    }
                    if !root.blocked && root.view == LauncherView.favorites
                        && !root.saved-favorites-present: Text {
                        text: "Your favorite applications appear here. Open All Apps to add favorites.";
                        color: SeelenPalette.secondary;
                        font-family: PopoverTokens.font-family;
                        font-size: 16px;
                        font-weight: 600;
                        font-italic: true;
                        line-height-factor: root.empty-line-height-factor;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        accessible-role: text;
                    }
                }
            }
            }

            // Notice is always visible. Routine successful diagnostics are not
            // a permanent track; only explicit feedback or recovery owns one.
            if root.notice != "": HorizontalLayout {
                padding: root.pad;
                Text {
                    text: root.notice;
                    color: SeelenPalette.secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
            if root.refreshing || root.stale || root.feedback-visible: HorizontalLayout {
                padding: root.pad;
                spacing: root.pad;
                Text {
                    text: root.status;
                    color: SeelenPalette.secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    accessible-role: text;
                }
                LauncherCommandButton {
                    input-scope: root.input-scope;
                    text: "Refresh";
                    enabled: root.input-available && !root.refreshing;
                    accessible-text: "Refresh the desktop";
                    clicked => { root.refresh-requested(); }
                }
                LauncherCommandButton {
                    input-scope: root.input-scope;
                    enabled: root.input-available;
                    text: "Exit";
                    accessible-text: "Exit Tessera";
                    clicked => { root.exit-requested(); }
                }
            }
            HorizontalLayout {
                padding: root.pad;
                spacing: root.pad;
                alignment: start;
                user-command := LauncherFooterButton {
                    activation-key: root.input-scope + "user";
                    min-width: 40px;
                    preferred-width: user-label.preferred-width + 48px;
                    max-width: max(40px, parent.width - 144px);
                    enabled: root.input-available;
                    accessible-text: "Open user menu";
                    tooltip-text: root.user-name == "" ? @tr("User name unavailable") : root.user-name;
                    tooltip-requested(content, bounds) => { root.tooltip-requested(content, bounds); }
                    tooltip-dismissed(delayed, origin) => {
                        root.dismiss-source-tooltip(delayed, origin, self.hovered);
                    }
                    clicked => {
                        root.open-user-menu-requested({
                            origin: self.absolute-position,
                            width: self.width, height: self.height
                        });
                    }
                    // Original generic schematic, explicitly not an account photo.
                    Rectangle {
                        x: 8px; y: 4px;
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: SeelenPalette.tile;
                        clip: true;
                        accessible-role: image;
                        accessible-label: @tr("Default user profile");
                        Rectangle {
                            x: 9px; y: 5px;
                            width: 6px; height: 6px;
                            border-radius: 3px;
                            background: SeelenPalette.secondary;
                            accessible-role: none;
                        }
                        Rectangle {
                            x: 6px; y: 13px;
                            width: 12px; height: 8px;
                            border-radius: 4px;
                            background: SeelenPalette.secondary;
                            accessible-role: none;
                        }
                    }
                    user-label := Text {
                        x: 40px;
                        width: max(0px, parent.width - 48px);
                        height: parent.height;
                        text: root.user-name == "" ? @tr("User name unavailable") : root.user-name;
                        font-family: PopoverTokens.font-family;
                        font-size: SeelenPalette.reference-mode ? 16px : SeelenPalette.body-font-size;
                        font-weight: SeelenPalette.title-font-weight;
                        color: SeelenPalette.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                settings-command := LauncherFooterButton {
                    activation-key: root.input-scope + "settings";
                    width: 32px;
                    enabled: root.input-available;
                    accessible-text: "Open settings and recovery";
                    tooltip-text: @tr("Settings");
                    tooltip-requested(content, bounds) => { root.tooltip-requested(content, bounds); }
                    tooltip-dismissed(delayed, origin) => {
                        root.dismiss-source-tooltip(delayed, origin, self.hovered);
                    }
                    clicked => { root.open-settings-requested(); }
                    Image {
                        x: 6px; y: 6px;
                        width: 20px; height: 20px;
                        source: @image-url("../assets/icons/remix-6da3244/settings-4-fill.svg");
                        image-fit: contain;
                        colorize: SeelenPalette.foreground;
                        accessible-role: none;
                    }
                }
                power-command := LauncherFooterButton {
                    activation-key: root.input-scope + "power";
                    width: 32px;
                    // Session actions do not borrow application refresh state.
                    enabled: root.input-available && !root.reorder-dragging;
                    accessible-text: @tr("Open power menu");
                    tooltip-text: @tr("Power menu");
                    tooltip-requested(content, bounds) => { root.tooltip-requested(content, bounds); }
                    tooltip-dismissed(delayed, origin) => {
                        root.dismiss-source-tooltip(delayed, origin, self.hovered);
                    }
                    clicked => { root.open-power-menu-requested(); }
                    Image {
                        x: 6px; y: 6px;
                        width: 20px; height: 20px;
                        source: @image-url("../assets/icons/ionicons-5.5.4/power.svg");
                        image-fit: contain;
                        colorize: SeelenPalette.foreground;
                        accessible-role: none;
                    }
                }
                mode-command := LauncherFooterButton {
                    activation-key: root.input-scope + "display-mode";
                    width: 32px;
                    enabled: !root.blocked;
                    accessible-text: root.display-mode == LauncherDisplayMode.Windowed
                        ? @tr("Expand applications menu") : @tr("Contract applications menu");
                    tooltip-text: self.accessible-text;
                    tooltip-requested(content, bounds) => { root.tooltip-requested(content, bounds); }
                    tooltip-dismissed(delayed, origin) => {
                        root.dismiss-source-tooltip(delayed, origin, self.hovered);
                    }
                    accessible-description: root.display-mode == LauncherDisplayMode.Windowed
                        ? @tr("Windowed") : @tr("Fullscreen");
                    accessible-checkable: true;
                    accessible-checked: root.display-mode == LauncherDisplayMode.Fullscreen;
                    clicked => {
                        root.display-mode-requested(root.display-mode == LauncherDisplayMode.Windowed
                            ? LauncherDisplayMode.Fullscreen : LauncherDisplayMode.Windowed);
                    }
                    Image {
                        x: 6px; y: 6px;
                        width: 20px; height: 20px;
                        source: root.display-mode == LauncherDisplayMode.Windowed
                            ? @image-url("../assets/icons/ionicons-5.5.4/expand-outline.svg")
                            : @image-url("../assets/icons/ionicons-5.5.4/contract-outline.svg");
                        image-fit: contain;
                        colorize: SeelenPalette.foreground;
                        accessible-role: none;
                    }
                }
            }
        }
        }
    }

    // One stable whole-tile visual, outside the native ListView clip.
    if root.reorder-visual.visible: drag-visual := LauncherTile {
        x: root.reorder-visual.bounds.origin.x;
        y: root.reorder-visual.bounds.origin.y;
        width: root.reorder-visual.bounds.width;
        height: root.reorder-visual.bounds.height;
        tile: root.reorder-visual.source;
        selected: root.reorder-visual.source.key == root.selected-key;
        interactive: false;
        feedback-scale: root.reorder-visual.source-scale;
        enabled: true;
        accessible-role: none;
    }
}
