import { ComboBox } from "std-widgets.slint";
import { SeelenPalette } from "palette.slint";

// Draft only: the containing panel owns its existing explicit Save transaction.
export component GeneralPreferences inherits VerticalLayout {
    in-out property <int> start-of-week-index: 0;
    in property <bool> compact: false;

    spacing: 12px;
    vertical-stretch: 0;

    HorizontalLayout {
        spacing: 12px;
        Text {
            text: "Start of week";
            color: SeelenPalette.foreground;
            vertical-alignment: center;
            font-weight: 600;
            horizontal-stretch: 1;
            // The native selector already owns this accessible label.
            accessible-role: none;
        }
        ComboBox {
            accessible-label: "Start of week";
            model: ["Monday", "Sunday", "Saturday"];
            current-index <=> root.start-of-week-index;
            width: 200px;
            min-height: 24px;
            max-height: 24px;
            vertical-stretch: 0;
            horizontal-stretch: 0;
        }
    }
}
