import { SeelenPalette } from "palette.slint";
import { PopoverTokens } from "popover.slint";
import { ApplicationIcon, TileButton, TileBounds } from "tiles.slint";

export struct LaunchTile {
    key: string,
    label: string,
    icon: image,
    favorite: bool,
}

// One appearance for native delegates and passive whole-tile drag feedback.
export component LauncherTile inherits TileButton {
    in property <LaunchTile> tile;
    // The window issues a fresh UI interaction scope; application authority
    // remains the original opaque key forwarded by the parent.
    in property <string> input-scope: "";
    activation-key: root.input-scope + root.tile.key;
    in property <bool> keyboard-selected: false;
    in property <float> feedback-scale: 1;
    out property <float> appearance-scale: self.pressed ? 0.95 : 1;
    callback favorite-pointer-metadata(PointerEvent, TileBounds, Point);
    callback favorite-toggle-requested();
    property <length> label-line-height: 17.92px;
    radius: 10px;
    filled: false;
    transform-scale: root.interactive ? root.appearance-scale : root.feedback-scale;
    background: !self.enabled ? transparent :
        (self.selected || self.focus-visible) ? SeelenPalette.accent.with-alpha(0.1) :
        self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
    accessible-text: "Launch " + root.tile.label;
    // Virtual rows can be created already selected, before any changed signal.
    init => {
        if root.keyboard-selected { root.focus-for-keyboard(); }
    }
    changed keyboard-selected => {
        if root.keyboard-selected { root.focus-for-keyboard(); }
    }
    label-metrics := Text {
        width: 0px;
        height: 0px;
        opacity: 0;
        text: "M";
        font-family: PopoverTokens.font-family;
        font-size: 12.8px;
        font-weight: 600;
        accessible-role: none;
    }

    // Clip icon/name content, not the external focus ring. Keep the fixed
    // reference label track even when the residual icon row becomes tiny.
    Rectangle {
        width: parent.width;
        height: parent.height;
        clip: true;
        accessible-role: none;
        icon-row := Rectangle {
            x: 8px;
            y: 8px;
            width: max(0px, parent.width - 16px);
            height: max(0px, parent.height - 16px - 8px - 35.2px);
            accessible-role: none;
            ApplicationIcon {
                property <length> side: min(icon-row.height, icon-row.width);
                x: (icon-row.width - self.side) / 2;
                y: (icon-row.height - self.side) / 2;
                width: self.side;
                height: self.side;
                source: root.tile.icon;
            }
        }
        // Track geometry stays source-sized. Native height elision needs the
        // full two line boxes; at 2x, ceil(35.2 * 2) cannot fit 2 * 17.92 * 2.
        label-track := Rectangle {
            x: 8px;
            y: icon-row.y + icon-row.height + 8px;
            width: max(0px, parent.width - 16px);
            height: 35.2px;
            clip: true;
            accessible-role: none;
            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 2 * root.label-line-height;
                text: root.tile.label;
                color: SeelenPalette.foreground;
                font-size: 12.8px;
                font-weight: 600;
                font-family: PopoverTokens.font-family;
                line-height-factor: label-metrics.preferred-height > 0px
                    ? root.label-line-height / label-metrics.preferred-height : 1;
                horizontal-alignment: center;
                vertical-alignment: top;
                wrap: word-wrap;
                overflow: elide;
                max-lines: 2;
                accessible-role: none;
            }
        }
    }

    favorite-control := TileButton {
        activation-key: root.input-scope + root.tile.key;
        width: 16px;
        height: 16px;
        x: parent.width - self.width;
        y: 0px;
        radius: 4px;
        filled: false;
        enabled: root.enabled;
        interactive: root.interactive;
        visible: root.interactive;
        report-pointer-metadata: root.report-pointer-metadata;
        pointer-metadata(event, bounds, point) => {
            root.favorite-pointer-metadata(event, bounds, point);
        }
        accessible-role: checkbox;
        accessible-checked: root.tile.favorite;
        accessible-text: (root.tile.favorite ? "Remove from favorites: " :
            "Add to favorites: ") + root.tile.label;
        clicked => { root.favorite-toggle-requested(); }
    }
    // Native checkbox remains reachable; hover or genuine keyboard focus
    // exposes its state/action. Idle tiles and passive drag feedback stay clean.
    if root.interactive && (root.hovered || root.focus-visible
        || favorite-control.hovered || favorite-control.has-focus): Rectangle {
        width: 8px;
        height: 8px;
        x: root.width - 12px;
        y: 4px;
        border-radius: 4px;
        background: root.tile.favorite ? SeelenPalette.accent : SeelenPalette.muted;
        opacity: root.enabled ? 1 : 0.5;
        accessible-role: none;
    }
}
