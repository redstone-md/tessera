import { SeelenPalette } from "palette.slint";
import { DockStatus } from "dock.slint";
import { TileButton, TileBounds } from "tiles.slint";

// One top toolbar, full monitor bounds width, 32 logical pixels tall
// (Seelen fancy-toolbar default: item 16 + padding 8 * 2 + margin 0).
// Left: user and foreground app. Center: native clock. Right: language and
// quick settings. Only genuine host values appear; absent slots stay empty.
export component Toolbar inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera toolbar";
    min-width: 1px;
    min-height: 1px;

    in property <string> user-name;
    in property <string> focused-app;
    in property <string> clock;
    in property <string> language;
    in property <DockStatus> surface-status;
    callback quick-settings-requested(TileBounds);
    callback calendar-requested(TileBounds);
    callback network-requested(TileBounds);
    callback bluetooth-requested(TileBounds);
    callback keyboard-requested(TileBounds);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point);

    property <length> pad: 8px;
    property <length> side-pad: 16px;
    property <length> item: 16px;
    property <length> tile-radius: 4.8px; // Seelen: item * 0.3

    Rectangle {
        background: SeelenPalette.bar.with-alpha(0.9);

        HorizontalLayout {
            x: root.side-pad;
            y: root.pad;
            width: max(0px, parent.width / 2 - clock-text.width / 2 - root.side-pad - root.pad);
            height: root.item;
            spacing: root.pad;
            alignment: start;
            Text {
                text: root.user-name;
                color: SeelenPalette.foreground;
                font-size: 12.8px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
            Rectangle {
                width: 1px;
                background: SeelenPalette.muted.with-alpha(0.5);
                accessible-role: none;
            }
            Text {
                text: root.focused-app;
                color: SeelenPalette.secondary;
                font-size: 12.8px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                accessible-role: text;
            }
        }
        clock-text := TileButton {
            x: (parent.width - self.width) / 2;
            y: root.pad;
            width: min(clock-label.preferred-width, parent.width / 3);
            height: root.item;
            radius: root.tile-radius;
            filled: false;
            enabled: root.clock != "";
            // Like the reference toolbar wrapper, not a common press-scale button.
            background: !self.enabled ? transparent :
                self.pressed ? SeelenPalette.accent.with-alpha(0.3) :
                self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
            accessible-text: @tr("Open calendar");
            tooltip-text: @tr("Calendar");
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.calendar-requested({
                origin: self.absolute-position,
                width: self.width,
                height: self.height
            }); }
            clock-label := Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.clock;
                color: SeelenPalette.foreground;
                font-size: 12.8px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
        }
        HorizontalLayout {
            x: parent.width / 2 + clock-text.width / 2 + root.pad;
            y: root.pad;
            width: max(0px, parent.width / 2 - clock-text.width / 2 - root.side-pad - root.pad);
            height: root.item;
            spacing: root.pad;
            alignment: end;
            TileButton {
                width: network-label.preferred-width;
                height: root.item;
                radius: root.tile-radius;
                filled: false;
                accessible-text: @tr("Open network");
                tooltip-text: @tr("Network");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.network-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                network-label := Text {
                    text: @tr("Network");
                    color: SeelenPalette.secondary;
                    font-size: 12.8px;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            TileButton {
                width: bluetooth-label.preferred-width;
                height: root.item;
                radius: root.tile-radius;
                filled: false;
                accessible-text: @tr("Open Bluetooth");
                tooltip-text: @tr("Bluetooth");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.bluetooth-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                bluetooth-label := Text {
                    text: @tr("Bluetooth");
                    color: SeelenPalette.secondary;
                    font-size: 12.8px;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            TileButton {
                width: max(root.item, language-label.preferred-width);
                height: root.item;
                radius: root.tile-radius;
                filled: false;
                accessible-text: @tr("Open keyboard selector");
                tooltip-text: @tr("Keyboard language");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.keyboard-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                language-label := Text {
                    text: root.language == "" ? @tr("Keyboard") : root.language;
                    color: SeelenPalette.secondary;
                    font-size: 12.8px;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            TileButton {
                width: root.item;
                height: root.item;
                radius: root.tile-radius;
                filled: false;
                // Reference Settings is a toolbar-item div, not a common
                // button: accent overlays apply, but no active transform.
                background: !self.enabled ? transparent :
                    self.pressed ? SeelenPalette.accent.with-alpha(0.3) :
                    self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent;
                accessible-text: "Open quick settings";
                tooltip-text: @tr("Quick settings");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.quick-settings-requested({
                    origin: self.absolute-position,
                    width: self.width,
                    height: self.height
                }); }
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("../assets/icons/lucide-0.468.0/settings-2.svg");
                    colorize: SeelenPalette.foreground;
                    accessible-role: none;
                }
            }
        }
    }
}
