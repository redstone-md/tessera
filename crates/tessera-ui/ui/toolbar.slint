import { SeelenPalette } from "palette.slint";
import { DockStatus } from "dock.slint";
import { TileButton, TileBounds } from "tiles.slint";

// Native TileButton remains the sole input/focus/tooltip owner.
component ToolbarButton inherits TileButton {
    radius: SeelenPalette.reference-mode ? 4.8px : self.height / 2;
    filled: false;
    background: SeelenPalette.reference-mode
        ? (!self.enabled ? transparent :
            self.pressed ? SeelenPalette.accent.with-alpha(0.3) :
            self.hovered ? SeelenPalette.accent.with-alpha(0.2) : transparent)
        : (!self.enabled ? (self.filled ? SeelenPalette.primary-container : transparent) :
            self.pressed ? SeelenPalette.primary-container-pressed :
            self.hovered ? SeelenPalette.primary-container-hover :
            self.filled ? SeelenPalette.primary-container : transparent);
}

component BarIsland inherits Rectangle {
    border-radius: self.height / 2;
    background: SeelenPalette.reference-mode ? transparent : SeelenPalette.primary-container;
}

// Source-informed 40px allocation, with 32px visible islands at 4px inset.
// This is a chosen native arrangement, not a certified video measurement.
// Left: user and foreground app. Center: native clock. Right: language and
// quick settings. Only genuine host values appear; absent slots stay empty.
export component Toolbar inherits Window {
    no-frame: true;
    always-on-top: true;
    background: transparent;
    title: "Tessera toolbar";
    min-width: 1px;
    min-height: 1px;

    in property <string> user-name;
    in property <string> focused-app;
    in property <string> clock;
    in property <string> language;
    in property <DockStatus> surface-status;
    callback quick-settings-requested(TileBounds);
    callback calendar-requested(TileBounds);
    callback network-requested(TileBounds);
    callback bluetooth-requested(TileBounds);
    callback keyboard-requested(TileBounds);
    callback tooltip-requested(string, TileBounds);
    callback tooltip-dismissed(bool, Point);

    property <length> pad: 8px;
    property <length> inset: 4px;
    property <length> side-pad: 16px;
    property <length> item: 16px;

    Rectangle {
        background: SeelenPalette.reference-mode ? SeelenPalette.bar.with-alpha(0.9) : transparent;

        BarIsland {
            x: root.side-pad;
            y: root.inset;
            width: min(user-label.preferred-width + focused-label.preferred-width + 6 * root.pad + 1px,
                max(0px, parent.width / 2 - clock-text.width / 2 - root.side-pad - root.pad));
            height: root.item + 2 * root.pad;
            HorizontalLayout {
            spacing: root.pad;
            // The title wrapper has no intrinsic width; assign it the spare
            // left-group budget instead of packing its preferred width (0).
            alignment: stretch;
            Rectangle {
                width: min(user-label.preferred-width + 2 * root.pad, max(0px, parent.width - 1px - 2 * root.pad));
                user-label := Text {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    text: root.user-name;
                    color: SeelenPalette.bar-content;
                    font-size: 12.8px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                }
            }
            Rectangle {
                y: root.pad;
                width: 1px;
                height: root.item;
                background: SeelenPalette.muted.with-alpha(0.5);
                accessible-role: none;
            }
            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                focused-label := Text {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    text: root.focused-app;
                    color: SeelenPalette.bar-secondary;
                    font-size: 12.8px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: text;
                }
            }
        }
        }
        clock-text := ToolbarButton {
            x: (parent.width - self.width) / 2;
            y: root.inset;
            width: min(clock-label.preferred-width + 2 * root.pad, parent.width / 3);
            height: root.item + 2 * root.pad;
            filled: true;
            enabled: root.clock != "";
            accessible-text: @tr("Open calendar");
            tooltip-text: @tr("Calendar");
            tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
            tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
            clicked => { root.calendar-requested({
                origin: self.absolute-position,
                width: self.width,
                height: self.height
            }); }
            clock-label := Text {
                x: root.pad;
                y: root.pad;
                width: max(0px, parent.width - 2 * root.pad);
                height: root.item;
                text: root.clock;
                color: SeelenPalette.bar-content;
                font-size: 12.8px;
                font-weight: 500;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
                accessible-role: text;
            }
        }
        BarIsland {
            x: parent.width - root.side-pad - self.width;
            y: root.inset;
            width: min(max(root.item, language-label.preferred-width) + 2 * root.pad
                + 3 * (root.item + 2 * root.pad) + 3 * root.pad,
                max(0px, parent.width / 2 - clock-text.width / 2 - root.side-pad - root.pad));
            height: root.item + 2 * root.pad;
            HorizontalLayout {
            spacing: root.pad;
            alignment: end;
            property <length> control-budget: min(root.item + 2 * root.pad, max(0px, (self.width - 3 * root.pad) / 4));
            property <length> text-budget: max(0px, self.width - 3 * self.control-budget - 3 * root.pad);
            ToolbarButton {
                width: min(max(root.item, language-label.preferred-width) + 2 * root.pad, parent.text-budget);
                height: root.item + 2 * root.pad;
                accessible-text: @tr("Open keyboard selector");
                tooltip-text: @tr("Keyboard language");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.keyboard-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                language-label := Text {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    text: root.language == "" ? @tr("Keyboard") : root.language;
                    color: SeelenPalette.bar-secondary;
                    font-size: 12.8px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            ToolbarButton {
                width: parent.control-budget;
                height: root.item + 2 * root.pad;
                accessible-text: @tr("Open Bluetooth");
                tooltip-text: @tr("Bluetooth");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.bluetooth-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                Image {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    source: @image-url("../assets/icons/tabler-icons-6d128ed/bluetooth.svg");
                    colorize: SeelenPalette.bar-secondary;
                    accessible-role: none;
                }
            }
            ToolbarButton {
                width: parent.control-budget;
                height: root.item + 2 * root.pad;
                accessible-text: @tr("Open network");
                tooltip-text: @tr("Network");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.network-requested({ origin: self.absolute-position, width: self.width, height: self.height }); }
                Image {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    source: @image-url("../assets/icons/tabler-icons-6d128ed/world.svg");
                    colorize: SeelenPalette.bar-secondary;
                    accessible-role: none;
                }
            }
            settings-button := ToolbarButton {
                width: parent.control-budget;
                height: root.item + 2 * root.pad;
                accessible-text: "Open quick settings";
                tooltip-text: @tr("Quick settings");
                tooltip-requested(text, bounds) => { root.tooltip-requested(text, bounds); }
                tooltip-dismissed(delayed, origin) => { root.tooltip-dismissed(delayed, origin); }
                clicked => { root.quick-settings-requested({
                    origin: self.absolute-position,
                    width: self.width,
                    height: self.height
                }); }
                Image {
                    x: root.pad;
                    y: root.pad;
                    width: max(0px, parent.width - 2 * root.pad);
                    height: root.item;
                    source: @image-url("../assets/icons/remix-6da3244/settings-4-fill.svg");
                    colorize: SeelenPalette.bar-content;
                    accessible-role: none;
                }
            }
        }
        }
    }
}
