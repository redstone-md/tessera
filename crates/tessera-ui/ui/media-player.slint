import { SeelenPalette } from "palette.slint";
import { PopoverTokens } from "popover.slint";
import { TileButton, TileBounds } from "tiles.slint";
import { DockMediaView, MediaAction, MediaSessionChoice } from "dock-media.slint";
import { CommonSlider } from "common-slider.slint";

component PlayerText inherits Text {
    color: SeelenPalette.foreground;
    font-size: PopoverTokens.font-size;
    font-family: PopoverTokens.font-family;
    wrap: word-wrap;
    accessible-role: text;
    accessible-label: self.text;
}

component TransportButton inherits TileButton {
    in property <DockMediaView> view;
    in property <MediaAction> action;
    callback requested(MediaAction, string);
    height: 30px;
    horizontal-stretch: 1;
    radius: 6px;
    activation-key: root.view.session-identity;
    allow-return-repeat: false;
    enabled: root.view.enabled && root.view.current-present && !root.view.busy && !root.view.stale
        && (root.action == MediaAction.previous ? root.view.previous-enabled
            : root.action == MediaAction.toggle ? root.view.toggle-enabled : root.view.next-enabled);
    accessible-text: root.action == MediaAction.previous ? @tr("Previous track")
        : root.action == MediaAction.toggle ? (root.view.playing ? @tr("Pause") : @tr("Play")) : @tr("Next track");
    clicked => { root.requested(root.action, root.view.session-identity); }
    PlayerText {
        width: parent.width;
        height: parent.height;
        text: root.action == MediaAction.previous ? @tr("Prev")
            : root.action == MediaAction.toggle ? (root.view.playing ? @tr("Pause") : @tr("Play")) : @tr("Next");
        horizontal-alignment: center;
        vertical-alignment: center;
        accessible-role: none;
        accessible-label: "";
    }
}

component PlayerChoice inherits TileButton {
    in property <MediaSessionChoice> choice;
    in property <TileBounds> clip-bounds;
    property <TileBounds> frame: { origin: root.absolute-position, width: root.width, height: root.height };
    changed frame => { root.cancel-input(); }
    changed clip-bounds => { root.cancel-input(); }
    callback requested(string);
    callback reveal-requested(TileBounds);
    height: 42px;
    radius: 6px;
    activation-key: root.choice.identity;
    allow-return-repeat: false;
    selected: root.choice.selected;
    // Offscreen rows remain in native Tab/AX traversal. Only a revealed frame
    // may select; focus or an offscreen AX action first reveals this exact row.
    enabled: root.choice.available;
    property <bool> frame-visible: root.frame.width > 0px && root.frame.height > 0px
        && root.frame.origin.x >= root.clip-bounds.origin.x
        && root.frame.origin.y >= root.clip-bounds.origin.y
        && root.frame.origin.x + root.frame.width <= root.clip-bounds.origin.x + root.clip-bounds.width
        && root.frame.origin.y + root.frame.height <= root.clip-bounds.origin.y + root.clip-bounds.height;
    accessible-text: (root.choice.selected ? @tr("Selected: ") : @tr("Select player: ")) + root.choice.label;
    focus-acquired => { root.reveal-requested(root.frame); }
    clicked => {
        if root.frame-visible {
            root.requested(root.choice.identity);
        } else {
            root.reveal-requested(root.frame);
        }
    }
    PlayerText {
        x: 8px;
        width: max(1px, parent.width - 16px);
        height: parent.height;
        text: (root.choice.selected ? @tr("Selected: ") : "") + root.choice.label;
        vertical-alignment: center;
        overflow: elide;
        font-weight: root.choice.selected ? 600 : 400;
        accessible-role: none;
        accessible-label: "";
    }
}

// One selected-player projection of the shared media domain.
// Observed timeline and Rust-scoped seek preview remain separate.
export component MediaPlayer inherits Rectangle {
    in property <DockMediaView> view;
    in property <[MediaSessionChoice]> choices;
    in property <TileBounds> clip-bounds;
    callback selection-requested(string);
    callback choice-reveal-requested(TileBounds);
    in property <bool> timeline-available;
    in property <string> timeline-notice;
    in property <string> timeline-time;
    in property <float> timeline-progress;
    in property <bool> seek-enabled;
    in property <float> seek-progress;
    in property <string> seek-notice;
    in property <bool> seek-preview-active;
    in property <float> seek-preview-progress;
    in property <string> seek-preview-time;
    // Native Slider assignments must not overwrite the observed/preview
    // projection. Keep its writable value local and reapply projection batches.
    property <float> displayed-seek-progress;
    public function project-seek() {
        root.displayed-seek-progress = clamp(root.seek-preview-active
            ? root.seek-preview-progress : root.seek-progress, 0, 1);
    }
    changed seek-progress => { root.project-seek(); }
    changed seek-preview-progress => { root.project-seek(); }
    changed seek-preview-active => { root.project-seek(); }
    out property <TileBounds> seek-bounds: {
        origin: seek-slider.absolute-position,
        width: seek-slider.width,
        height: seek-slider.height
    };
    callback seek-requested(float);
    callback seek-released();
    callback seek-key-pressed(string);
    callback seek-key-released(string);
    in property <length> measure-width;
    callback action-requested(MediaAction, string);
    accessible-role: groupbox;
    accessible-label: @tr("Media playback");

    property <string> notices: (root.view.stale ? @tr("Stale media observation") : "")
        + (root.view.read-notice == "" ? "" : (root.view.stale ? "\n" : "") + root.view.read-notice)
        + (root.view.watch-notice == "" ? "" : (root.view.stale || root.view.read-notice != "" ? "\n" : "") + root.view.watch-notice)
        + (root.view.action-notice == "" ? "" : (root.view.stale || root.view.read-notice != "" || root.view.watch-notice != "" ? "\n" : "") + root.view.action-notice)
        + (root.view.artwork-notice == "" ? "" : (root.view.stale || root.view.read-notice != "" || root.view.watch-notice != "" || root.view.action-notice != "" ? "\n" : "") + root.view.artwork-notice);
    property <string> metadata: root.view.title
        + (root.view.author == "" ? "" : "\n" + root.view.author)
        + (root.view.playback == "" ? "" : "\n" + root.view.playback);
    property <string> observed-time: root.timeline-time == "" ? "" : @tr("Observed position: ") + root.timeline-time;
    property <bool> preview-row-present: root.seek-enabled || root.timeline-available;
    property <string> preview-time: @tr("Preview position: ") + root.seek-preview-time;
    property <int> block-count: 3 + (root.view.current-present ? 1 : 0)
        + (root.view.status != "" ? 1 : 0) + (root.notices != "" ? 1 : 0)
        + (root.timeline-available ? 1 : 0) + (root.timeline-notice != "" ? 1 : 0)
        + (root.seek-notice != "" ? 1 : 0) + (root.preview-row-present ? 1 : 0)
        + (root.choices.length > 0 ? 1 : 0);
    out property <length> natural-height: heading-metrics.preferred-height
        + root.choices.length * 42px + max(0, root.choices.length - 1) * 4px
        + (root.view.current-present ? max(40px, metadata-metrics.preferred-height) + 30px : 0px)
        + (root.view.status != "" ? status-metrics.preferred-height : 0px)
        + (root.notices != "" ? notice-metrics.preferred-height : 0px)
        + (root.timeline-available ? 4px + (root.observed-time != "" ? time-metrics.preferred-height + 4px : 0px) : 0px)
        + 24px + (root.seek-notice != "" ? seek-metrics.preferred-height : 0px)
        + (root.timeline-notice != "" ? timeline-metrics.preferred-height : 0px)
        + (root.preview-row-present ? preview-metrics.preferred-height : 0px)
        + max(0, root.block-count - 1) * 8px;
    height: root.natural-height;

    // Static probes settle directly from the new projection, before layout.
    heading-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.choices.length > 0 ? @tr("Media players") : @tr("Current player"); font-weight: 600; accessible-role: none; accessible-label: ""; }
    metadata-metrics := PlayerText { width: max(1px, root.measure-width - (root.view.has-artwork ? 48px : 0px) - (root.view.has-app-icon ? 24px : 0px)); height: 0px; opacity: 0; text: root.metadata; accessible-role: none; accessible-label: ""; }
    status-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.view.status; accessible-role: none; accessible-label: ""; }
    notice-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.notices; accessible-role: none; accessible-label: ""; }
    time-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.observed-time; accessible-role: none; accessible-label: ""; }
    timeline-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.timeline-notice; accessible-role: none; accessible-label: ""; }
    seek-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: root.seek-notice; accessible-role: none; accessible-label: ""; }
    // A single reserved line never changes height with the tentative time,
    // so preview projection cannot move the Slider and revoke its gesture.
    preview-metrics := PlayerText { width: root.measure-width; height: 0px; opacity: 0; text: @tr("Preview position: ") + "0:00"; wrap: no-wrap; accessible-role: none; accessible-label: ""; }

    public function cancel-input() {
        previous.cancel-input();
        toggle.cancel-input();
        next.cancel-input();
    }
    VerticalLayout {
        spacing: 8px;
        PlayerText { text: root.choices.length > 0 ? @tr("Media players") : @tr("Current player"); font-weight: 600; }
        if root.choices.length > 0: VerticalLayout {
            spacing: 4px;
            for option in root.choices: PlayerChoice {
                choice: option;
                clip-bounds: root.clip-bounds;
                requested(identity) => { root.selection-requested(identity); }
                reveal-requested(bounds) => { root.choice-reveal-requested(bounds); }
            }
        }
        if root.view.current-present: HorizontalLayout {
            spacing: 8px;
            height: max(40px, metadata-metrics.preferred-height);
            // Shared projection supplies any raster-rounded cover; the app
            // identity stays a separate trusted sibling, as in the reference.
            if root.view.has-artwork: Image {
                width: 40px;
                height: 40px;
                source: root.view.artwork;
                image-fit: cover;
                accessible-role: none;
            }
            PlayerText { text: root.metadata; horizontal-stretch: 1; }
            if root.view.has-app-icon: Image {
                width: 16px;
                height: 16px;
                source: root.view.app-icon;
                image-fit: contain;
                accessible-role: none;
            }
        }
        if root.view.status != "": PlayerText { text: root.view.status; color: SeelenPalette.secondary; }
        if root.notices != "": PlayerText { text: root.notices; color: SeelenPalette.secondary; }
        transports := Rectangle {
            visible: root.view.current-present;
            height: root.view.current-present ? 30px : 0px;
            accessible-role: none;
            HorizontalLayout {
                spacing: 8px;
                previous := TransportButton { view: root.view; action: MediaAction.previous; requested(action, identity) => { root.action-requested(action, identity); } }
                toggle := TransportButton { view: root.view; action: MediaAction.toggle; requested(action, identity) => { root.action-requested(action, identity); } }
                next := TransportButton { view: root.view; action: MediaAction.next; requested(action, identity) => { root.action-requested(action, identity); } }
            }
        }
        if root.timeline-available: VerticalLayout {
            spacing: 4px;
            if root.observed-time != "": PlayerText { text: root.observed-time; }
            Rectangle {
                height: 4px;
                background: SeelenPalette.tile;
                border-radius: 2px;
                accessible-role: none;
                Rectangle { width: parent.width * clamp(root.timeline-progress, 0, 1); height: parent.height; background: SeelenPalette.foreground; border-radius: 2px; accessible-role: none; }
            }
        }
        if root.preview-row-present: Rectangle {
            height: preview-metrics.preferred-height;
            accessible-role: none;
            if root.seek-preview-active && root.seek-preview-time != "": PlayerText {
                width: parent.width;
                height: parent.height;
                text: root.preview-time;
                wrap: no-wrap;
                overflow: elide;
            }
        }
        // Keep the native Slider alive across unavailable/current projections.
        // Rust captures authority before pointer input or native key changes;
        // disabled/reenabled widget internals are never used as cancellation.
        FocusScope {
            height: 24px;
            horizontal-stretch: 1;
            focus-on-tab-navigation: false;
            forward-focus: seek-slider;
            capture-key-pressed(event) => {
                if seek-slider.enabled && seek-slider.has-focus
                    && (event.text == Key.LeftArrow || event.text == Key.RightArrow
                        || event.text == Key.Home || event.text == Key.End) {
                    root.seek-key-pressed(event.text);
                }
                return reject;
            }
            capture-key-released(event) => {
                if seek-slider.has-focus
                    && (event.text == Key.LeftArrow || event.text == Key.RightArrow
                        || event.text == Key.Home || event.text == Key.End) {
                    root.seek-key-released(event.text);
                }
                return reject;
            }
            seek-slider := CommonSlider {
                width: parent.width;
                minimum: 0;
                maximum: 1;
                step: 0.01;
                enabled: root.seek-enabled && root.view.enabled && root.view.current-present;
                value <=> root.displayed-seek-progress;
                accessible-label: @tr("Media position");
                accessible-description: root.seek-notice != "" ? root.seek-notice
                    : root.seek-preview-active ? root.preview-time : root.observed-time;
                changed(progress) => {
                    if self.enabled { root.seek-requested(clamp(progress, 0, 1)); }
                }
                // Release ends local preview only. Native changed owns requests.
                released(progress) => { root.seek-released(); }
            }
        }
        if root.seek-notice != "": PlayerText { text: root.seek-notice; color: SeelenPalette.secondary; }
        if root.timeline-notice != "": PlayerText { text: root.timeline-notice; color: SeelenPalette.secondary; }
    }
}
